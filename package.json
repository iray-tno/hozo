{
  "name": "hozo",
  "private": true,
  "version": "0.0.0",
  "description": "A Rust-powered universal UI compiler and accessibility-first layer for React Native.",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "audit": "cargo audit && pnpm audit --audit-level critical",
    "audit:cargo": "cargo audit",
    "audit:pnpm": "pnpm audit --audit-level critical",
    "build": "turbo run build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "changeset": "changeset",
    "check:packages": "node scripts/check-packages.mjs",
    "dev": "turbo run dev",
    "docs:primitives": "node scripts/primitives-reference.mjs",
    "docs:primitives:check": "node scripts/primitives-reference.mjs --check",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "measure:bluesky": "node scripts/measure-corpus.mjs bluesky-social-app",
    "measure:bluesky:rnw-free": "node scripts/measure-rnw-free-build.mjs",
    "measure:real-app": "node packages/migration-audit/src/cli.mjs",
    "report:allure": "pnpm --filter @hozo/test-reporter exec allure generate -o ../../apps/landing/dist/reports ../../junit-reports",
    "report:conformance": "pnpm --filter @hozo/compiler build:native:release && turbo run report -- --check",
    "test": "pnpm test:packages && pnpm test:integration",
    "test:integration": "turbo run test --filter=./apps/* --filter=./examples/*",
    "test:junit": "node packages/test-reporter/src/run-tests-junit.mjs",
    "test:packages": "turbo run build --filter=./packages/* && turbo run test --filter=./packages/* && node scripts/check-packages.mjs",
    "test:performance": "turbo run test:performance --filter=@hozo/canvas --filter=@hozo/runtime",
    "typecheck": "turbo run typecheck",
    "version": "changeset version && node scripts/package-metadata.mjs && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@types/node": "26.2.0",
    "aria-query": "^5.3.2",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.3.0",
    "typescript": "^7.0.2"
  }
}
