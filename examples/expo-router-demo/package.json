{
  "name": "@hozo/example-expo-router-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Real Expo Router type and production-export fixture for @hozo/navigation.",
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "build": "pnpm run build:web && pnpm run build:android",
    "build:web": "expo export --platform web --output-dir dist/web",
    "build:android": "expo export --platform android --output-dir dist/android",
    "test": "tsc -p . --noEmit",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "^57.0.15",
    "@hozo/core": "workspace:*",
    "@hozo/navigation": "workspace:*",
    "@hozo/runtime": "workspace:*",
    "expo": "^57.0.20",
    "expo-constants": "^57.0.17",
    "expo-linking": "^57.0.9",
    "expo-router": "^57.0.19",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@hozo/metro": "workspace:*",
    "@types/react": "^19.2.18",
    "typescript": "~6.0.3"
  }
}
