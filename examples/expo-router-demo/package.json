{
  "name": "@hozo/example-expo-router-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Real Expo Router type and production-export fixture for @hozo/navigation.",
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "build": "pnpm run build:web && pnpm run build:android",
    "build:web": "expo export --platform web --output-dir dist/web",
    "build:android": "expo export --platform android --output-dir dist/android",
    "test": "tsc -p . --noEmit && node scripts/check-config.mjs",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/material-symbols": "^0.4.45",
    "@expo/metro-runtime": "^58.0.16",
    "@hozo/core": "workspace:*",
    "@hozo/navigation": "workspace:*",
    "@hozo/typography": "workspace:*",
    "expo": "^58.0.22",
    "expo-constants": "^58.0.14",
    "expo-linking": "^58.0.15",
    "expo-font": "^58.0.11",
    "expo-router": "^58.0.29",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@hozo/metro": "workspace:*",
    "@types/react": "^19.2.18",
    "typescript": "~6.0.3"
  }
}
