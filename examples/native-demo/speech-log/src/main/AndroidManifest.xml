<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:label="Hozo speech log">
        <!-- Exported and filtered on TTS_SERVICE: that is how Android and
             TalkBack find an engine. `tts_default_synth` then picks it. -->
        <service
            android:name=".SpeechLogService"
            android:exported="true"
            android:label="Hozo speech log">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech.tts"
                android:resource="@xml/tts_engine" />
        </service>
        <!-- Test-only peer of TalkBack. It performs ACTION_CLICK on a named
             node after TalkBack has proved the spoken navigation contract. -->
        <service
            android:name=".AccessibilityActionService"
            android:exported="true"
            android:label="Hozo accessibility action driver"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
    </application>
</manifest>
