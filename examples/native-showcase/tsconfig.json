{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "react-native": ["./node_modules/react-native/types_generated/index.d.ts"]
    }
  },
  "include": [
    "App.tsx",
    "index.ts",
    "src/**/*.tsx",
    ".rnstorybook/**/*.ts",
    ".rnstorybook/**/*.tsx"
  ]
}
