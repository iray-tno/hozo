{
  "expo": {
    "name": "Hozo Showcase",
    "slug": "hozo-native-showcase",
    "scheme": "hozo-showcase",
    "version": "1.0.0",
    "orientation": "default",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "-keepclassmembers class expo.modules.gl.GLView {\n  public <init>(android.content.Context, expo.modules.kotlin.AppContext);\n}\n\n-keepclassmembers class expo.modules.gl.GLContext {\n  public void flush();\n}"
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "dev.hozo.showcase",
      "supportsTablet": true
    },
    "android": {
      "package": "dev.hozo.showcase"
    }
  }
}
