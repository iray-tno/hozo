{
  "name": "@hozo/example-native-showcase",
  "version": "0.0.0",
  "private": true,
  "description": "Expo development app with on-device React Native Storybook and shared Hozo demos.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "smoke:android": "node scripts/android-smoke.mjs",
    "stories": "sb-rn-get-stories",
    "test:unit": "node --test scripts/*.test.mjs",
    "test": "pnpm test:unit && node scripts/check-bundles.mjs",
    "typecheck": "pnpm stories && tsc -p .",
    "bundle:android": "expo export --platform android --output-dir dist/android",
    "bundle:ios": "expo export --platform ios --output-dir dist/ios"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.8",
    "@hozo/core": "workspace:^",
    "@hozo/example-showcase": "workspace:*",
    "@hozo/example-three-kumimono": "workspace:*",
    "@hozo/primitives": "workspace:^",
    "@hozo/three": "workspace:^",
    "@hozo/typography": "workspace:^",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@react-three/fiber": "^9.8.1",
    "@storybook/addon-ondevice-actions": "10.6.0",
    "@storybook/addon-ondevice-controls": "10.6.0",
    "@storybook/react-native": "10.6.0",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-gl": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.8.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "storybook": "10.6.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@hozo/metro": "workspace:^",
    "@types/react": "~19.2.2",
    "@types/three": "^0.180.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3"
  }
}
