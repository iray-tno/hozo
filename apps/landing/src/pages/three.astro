---
import { DomainNav } from '../components/DomainNav.tsx'
import { Footer } from '../components/Footer.tsx'
import { Navbar } from '../components/Navbar.tsx'
import SiteHead from '../components/SiteHead.astro'
import {
  KumimonoProof,
  ThreeAuthoring,
  ThreeCapabilities,
  ThreeIntro,
} from '../components/three/ThreePage.tsx'
import '../styles/global.css'

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <SiteHead
      title="Three.js & 3D Spatial Graphics — Hozo"
      description="Unified WebGL, WebGPU, and Native GPU 3D pipeline for React Native. Author scenes once with Three.js and React Three Fiber; run across Web, Hermes, iOS and Android."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-yakisugi-950 text-shikkui antialiased min-h-screen relative grid-background">
    <Navbar baseUrl={baseUrl} />

    <main class="pt-24 pb-20 md:pt-32 md:pb-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <DomainNav baseUrl={baseUrl} currentDomain="three" />

      <ThreeIntro />
      <KumimonoProof client:visible baseUrl={baseUrl} />
      <ThreeCapabilities />
      <ThreeAuthoring />
    </main>

    <Footer baseUrl={baseUrl} />
  </body>
</html>
