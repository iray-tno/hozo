---
import { DomainNav } from '../components/DomainNav.tsx'
import { Footer } from '../components/Footer.tsx'
import { Navbar } from '../components/Navbar.tsx'
import SiteHead from '../components/SiteHead.astro'
import chipSource from '../components/tailwind/Chip.tsx?raw'
import { ChipDemo } from '../components/tailwind/ChipDemo.tsx'
import { compileSample, nativeGaps, probeVariants } from '../components/tailwind/compiled.ts'
import {
  TailwindConformanceLink,
  TailwindIntro,
  TailwindMeasured,
  TailwindNativeGaps,
  TailwindSample,
  TailwindSampleIntro,
  TailwindTheme,
  TailwindVariants,
} from '../components/tailwind/TailwindPage.tsx'
import '../styles/global.css'
import snapshot from '../../../../packages/tailwind-conformance/snapshot.json'

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '')
const compiled = compileSample(chipSource)
const variants = probeVariants()
const gaps = nativeGaps(snapshot.native)
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <SiteHead
      title="Tailwind CSS, Compiled — Hozo"
      description="Tailwind classes on Hozo primitives, compiled at build time to scoped CSS on the Web and StyleSheet objects on iOS and Android, with every class a platform cannot honour named in a diagnostic."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-yakisugi-950 text-shikkui antialiased min-h-screen relative grid-background">
    <Navbar baseUrl={baseUrl} />

    <main class="pt-24 pb-20 md:pt-32 md:pb-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <DomainNav baseUrl={baseUrl} currentDomain="tailwind" />

      <TailwindIntro tailwind={snapshot.versions.tailwind} />
      <TailwindSampleIntro />
      <ChipDemo client:visible />
      <TailwindSample source={chipSource} compiled={compiled} />
      <TailwindVariants rows={variants} />
      <TailwindMeasured numbers={snapshot} />
      <TailwindNativeGaps gaps={gaps} />
      <TailwindTheme />
      <TailwindConformanceLink baseUrl={baseUrl} />
    </main>

    <Footer baseUrl={baseUrl} />
  </body>
</html>
