---
// The compiler, in the browser.
//
// `crates/hozo_wasm` is the same compiler `@hozo/vite` and `@hozo/metro`
// run, through a second binding rather than a second implementation --
// `packages/tailwind-conformance/src/wasm-binding.test.ts` compares the
// two answers whole, because a REPL that says a file compiles while the
// build says it does not is worse than no REPL.
//
// CodeJar and Prism rather than Monaco: the editor should not outweigh the
// compiler it is there to show.
import { Footer } from '../components/Footer.tsx'
import { Navbar } from '../components/Navbar.tsx'
import { Repl, ReplIntro } from '../components/repl/ReplPage.tsx'
import SiteHead from '../components/SiteHead.astro'
import '../styles/global.css'

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '')

const EXAMPLE = `import { View, Text, Pressable } from '@hozo/core'

export function Card() {
  return (
    <View className="p-4 rounded-lg bg-slate-100 dark:bg-slate-800 md:p-6">
      <Text className="text-xl font-bold">Sales</Text>
      <Pressable onPress={() => {}}>
        <Text className="text-sky-600">Open</Text>
      </Pressable>
    </View>
  )
}
`
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <SiteHead
      title="REPL — Hozo Universal UI Compiler"
      description="Compile TSX to Web and React Native output in the browser, with the diagnostics a build would report. The Hozo compiler, running as WebAssembly."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-yakisugi-950 text-shikkui antialiased min-h-screen relative grid-background">
    <Navbar baseUrl={baseUrl} />

    <main class="pt-24 pb-20 md:pt-32 md:pb-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ReplIntro />
      <Repl example={EXAMPLE} />
    </main>

    <Footer baseUrl={baseUrl} />
    <script>
      import '../scripts/repl.ts'
    </script>
    <style is:global>
      /* Prism Syntax Highlighting - Hozo Timber Palette */
      .token.comment,
      .token.prolog,
      .token.doctype,
      .token.cdata {
        color: #64748b;
        font-style: italic;
      }
      .token.punctuation {
        color: #94a3b8;
      }
      .token.property,
      .token.tag,
      .token.boolean,
      .token.number,
      .token.constant,
      .token.symbol,
      .token.deleted {
        color: #f43f5e;
      }
      .token.selector,
      .token.attr-name,
      .token.string,
      .token.char,
      .token.builtin,
      .token.inserted {
        color: #34d399;
      }
      .token.operator,
      .token.entity,
      .token.url {
        color: #cbd5e1;
      }
      .token.atrule,
      .token.attr-value,
      .token.keyword {
        color: #c8a882;
      }
      .token.function,
      .token.class-name {
        color: #38bdf8;
      }
      .token.regex,
      .token.important,
      .token.variable {
        color: #fb923c;
      }

      /* CodeJar container styles */
      #repl-source:focus-visible {
        outline: 2px solid var(--color-hinoki);
        outline-offset: 2px;
      }
      /* A View is a flex column; Prism's token spans must flow as text. */
      #repl-source {
        display: block;
        tab-size: 2;
        -moz-tab-size: 2;
        white-space: pre-wrap;
        word-break: break-word;
      }
    </style>
  </body>
</html>
