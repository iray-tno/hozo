---
// The compiler, in the browser.
//
// `crates/hozo_wasm` is the same compiler `@hozo/vite` and `@hozo/metro`
// run, through a second binding rather than a second implementation --
// `packages/tailwind-conformance/src/wasm-binding.test.ts` compares the
// two answers whole, because a REPL that says a file compiles while the
// build says it does not is worse than no REPL.
//
// An ultra-lightweight micro-editor (CodeJar ~2KB + PrismJS ~15KB) rather than
// Monaco. Monaco is more than twice the size of the compiler (5-10MB+), whereas
// CodeJar and PrismJS provide instant syntax highlighting, tab indentation, and
// clean caret handling with under 20KB footprint.
import { Footer } from '../components/Footer.tsx'
import { Navbar } from '../components/Navbar.tsx'
import '../styles/global.css'

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '')

const EXAMPLE = `import { View, Text, Pressable } from '@hozo/core'

export function Card() {
  return (
    <View className="p-4 rounded-lg bg-slate-100 dark:bg-slate-800 md:p-6">
      <Text className="text-xl font-bold">Sales</Text>
      <Pressable onPress={() => {}}>
        <Text className="text-sky-600">Open</Text>
      </Pressable>
    </View>
  )
}
`

const PANES = [
  { id: 'repl-web-jsx', title: 'Web', note: 'JSX' },
  { id: 'repl-web-css', title: 'Web', note: 'CSS' },
  { id: 'repl-native-jsx', title: 'React Native', note: 'JSX' },
  { id: 'repl-native-styles', title: 'React Native', note: 'StyleSheet' },
]
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>REPL — Hozo Universal UI Compiler</title>
    <meta
      name="description"
      content="Compile TSX to Web and React Native output in the browser, with the diagnostics a build would report. The Hozo compiler, running as WebAssembly."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#0a0c10] text-slate-200 antialiased min-h-screen relative grid-background">
    <Navbar baseUrl={baseUrl} />

    <main class="pt-28 pb-24 md:pt-32 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8">
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">
          The compiler, <span class="gradient-text">in your browser</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-300 max-w-3xl leading-relaxed">
          The same compiler <code class="font-mono text-sm text-sky-300">@hozo/vite</code> and
          <code class="font-mono text-sm text-sky-300">@hozo/metro</code> run, built to WebAssembly.
          Nothing is sent anywhere: it compiles here, in this tab.
        </p>
        <p class="mt-3 text-sm text-slate-500 max-w-3xl">
          Against Hozo's default theme — a project's own theme is read from its configuration, and a
          page has no project.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-6">
        <section class="flex flex-col">
          <header class="flex items-baseline justify-between mb-2">
            <h2 class="text-sm font-semibold text-slate-300">Source</h2>
            <span id="repl-status" class="font-mono text-xs text-slate-500">Loading…</span>
          </header>
          <div
            id="repl-source"
            role="textbox"
            aria-multiline="true"
            aria-label="TSX to compile"
            class="w-full h-[22rem] lg:h-[34rem] rounded-xl bg-slate-950/80 border border-white/10 p-4 font-mono text-sm text-slate-200 leading-relaxed overflow-auto focus:outline-none focus:ring-2 focus:ring-indigo-500/60"
          >{EXAMPLE}</div>

          <h2 class="text-sm font-semibold text-slate-300 mt-6 mb-2">Diagnostics</h2>
          <div id="repl-diagnostics" class="flex flex-col gap-2">
            <p class="text-sm text-slate-500">Compiling…</p>
          </div>
        </section>

        <section class="grid gap-4 content-start">
          {
            PANES.map((pane) => (
              <div class="rounded-xl bg-slate-950/80 border border-white/10 overflow-hidden">
                <header class="flex items-baseline gap-2 px-4 py-2 border-b border-white/10 bg-white/[0.02]">
                  <span class="text-sm font-semibold text-slate-200">{pane.title}</span>
                  <span class="font-mono text-xs text-slate-500">{pane.note}</span>
                </header>
                <pre
                  id={pane.id}
                  class="p-4 overflow-x-auto font-mono text-xs text-slate-300 leading-relaxed max-h-64"
                />
              </div>
            ))
          }
        </section>
      </div>
    </main>

    <Footer baseUrl={baseUrl} />
    <script>
      import '../scripts/repl.ts'
    </script>
    <style is:global>
      /* Prism Syntax Highlighting - Hozo Timber Palette */
      .token.comment,
      .token.prolog,
      .token.doctype,
      .token.cdata {
        color: #64748b;
        font-style: italic;
      }
      .token.punctuation {
        color: #94a3b8;
      }
      .token.property,
      .token.tag,
      .token.boolean,
      .token.number,
      .token.constant,
      .token.symbol,
      .token.deleted {
        color: #f43f5e;
      }
      .token.selector,
      .token.attr-name,
      .token.string,
      .token.char,
      .token.builtin,
      .token.inserted {
        color: #34d399;
      }
      .token.operator,
      .token.entity,
      .token.url {
        color: #cbd5e1;
      }
      .token.atrule,
      .token.attr-value,
      .token.keyword {
        color: #c8a882;
      }
      .token.function,
      .token.class-name {
        color: #38bdf8;
      }
      .token.regex,
      .token.important,
      .token.variable {
        color: #fb923c;
      }

      /* CodeJar container styles */
      #repl-source {
        tab-size: 2;
        -moz-tab-size: 2;
        white-space: pre-wrap;
        word-break: break-word;
      }
    </style>
  </body>
</html>
