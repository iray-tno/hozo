---
import Footer from '../components/Footer.astro'
import Navbar from '../components/Navbar.astro'
import '../styles/global.css'
import snapshot from '../../../../packages/tailwind-conformance/snapshot.json'

const pct = (n: number, d: number) => (d === 0 ? '--' : `${((n / d) * 100).toFixed(1)}%`)
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>Conformance Matrix — Hozo Universal UI Compiler</title>
    <meta
      name="description"
      content="Automated, differential cross-platform conformance matrix for Hozo. Verified directly in CI against Tailwind CSS, React Native Fabric, StyleX, and W3C ARIA specs."
    />
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#0a0c10] text-slate-200 antialiased min-h-screen relative grid-background">
    <Navbar />

    <main class="pt-28 pb-24 md:pt-36 md:pb-32 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb / Header Header -->
      <div class="mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900/80 border border-slate-700/60 shadow-inner mb-4">
          <span class="flex h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-xs font-semibold text-slate-300">Automated Differential Snapshot</span>
          <span class="text-xs text-slate-500">•</span>
          <span class="text-xs text-indigo-400 font-mono">CI Verified</span>
        </div>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white mb-4">
          Cross-Platform <span class="gradient-text">Conformance Matrix</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-300 max-w-3xl leading-relaxed mb-6">
          This matrix is generated directly from automated test suites run in CI. Rather than hand-writing an idealized compatibility table, Hozo continually validates itself against the real Tailwind engine, React Native's Fabric types, StyleX, and the machine-readable W3C ARIA specification.
        </p>

        <!-- Environment & Versions Badge Bar -->
        <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-slate-400 p-3 rounded-xl bg-slate-900/60 border border-white/10">
          <span class="text-slate-500 font-sans font-semibold">Test Oracle Targets:</span>
          <span class="px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-sky-300">
            Tailwind CSS <strong class="text-white">v{snapshot.versions.tailwind}</strong>
          </span>
          <span class="px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-emerald-300">
            React Native <strong class="text-white">v{snapshot.versions.reactNative}</strong>
          </span>
          <span class="px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-pink-300">
            StyleX <strong class="text-white">v{snapshot.versions.stylex}</strong>
          </span>
          <span class="px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-amber-300">
            W3C ARIA <strong class="text-white">aria-query</strong>
          </span>
        </div>
      </div>

      <!-- Headline KPI Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-16">
        <!-- Web KPI -->
        <div class="p-6 rounded-2xl glass-panel border-t-2 border-t-sky-400 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-sky-400">Web Backend</span>
              <span class="text-[10px] px-2 py-0.5 rounded bg-sky-500/10 text-sky-300 border border-sky-500/20">hozo_web</span>
            </div>
            <div class="text-3xl sm:text-4xl font-extrabold text-white mb-1">
              {pct(snapshot.web.fidelity, snapshot.web.coverage)}
            </div>
            <div class="text-xs text-slate-400 mb-4">Exact Oracle Fidelity</div>
            <p class="text-xs text-slate-300 leading-relaxed">
              <strong>{snapshot.web.fidelity}/{snapshot.web.coverage}</strong> representative candidates and <strong>{snapshot.catalogue.match.toLocaleString()}</strong> full catalogue rules match official Tailwind output with zero divergence.
            </p>
          </div>
          <div class="mt-4 pt-4 border-t border-white/5 text-[11px] text-sky-300/80">
            &check; Exact CSS property & value parity
          </div>
        </div>

        <!-- Native KPI -->
        <div class="p-6 rounded-2xl glass-panel border-t-2 border-t-emerald-400 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-400">Native Backend</span>
              <span class="text-[10px] px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-300 border border-emerald-500/20">hozo_native</span>
            </div>
            <div class="text-3xl sm:text-4xl font-extrabold text-white mb-1">
              {pct(snapshot.native.covered, snapshot.native.candidates)}
            </div>
            <div class="text-xs text-slate-400 mb-4">Fabric Style Coverage</div>
            <p class="text-xs text-slate-300 leading-relaxed">
              <strong>{snapshot.native.covered}/{snapshot.native.candidates}</strong> candidates lowered to Fabric primitives & StyleSheet. 5 refused with compiler diagnostics.
            </p>
          </div>
          <div class="mt-4 pt-4 border-t border-white/5 text-[11px] text-emerald-300/80 font-semibold">
            &check; 0 silent failures (guaranteed)
          </div>
        </div>

        <!-- StyleX KPI -->
        <div class="p-6 rounded-2xl glass-panel border-t-2 border-t-pink-400 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-pink-400">StyleX Surface</span>
              <span class="text-[10px] px-2 py-0.5 rounded bg-pink-500/10 text-pink-300 border border-pink-500/20">Universal Subsets</span>
            </div>
            <div class="text-3xl sm:text-4xl font-extrabold text-white mb-1">
              {pct(snapshot.stylex.mappedProductRelevant, snapshot.stylex.productRelevantProperties)}
            </div>
            <div class="text-xs text-slate-400 mb-4">Actionable Product Surface</div>
            <p class="text-xs text-slate-300 leading-relaxed">
              <strong>{snapshot.stylex.mappedCompilerRelevant}/{snapshot.stylex.compilerRelevantProperties}</strong> compiler-relevant names are mapped; only one optional adapter remains.
            </p>
          </div>
          <div class="mt-4 pt-4 border-t border-white/5 text-[11px] text-pink-300/80">
            &check; Raw published-type coverage remains {snapshot.stylex.mapped}/{snapshot.stylex.properties}
          </div>
        </div>

        <!-- Accessibility KPI -->
        <div class="p-6 rounded-2xl glass-panel border-t-2 border-t-indigo-400 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-indigo-400">ARIA Invariant</span>
              <span class="text-[10px] px-2 py-0.5 rounded bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">W3C Specification</span>
            </div>
            <div class="text-3xl sm:text-4xl font-extrabold text-white mb-1">
              {snapshot.ariaRoles.roles}
            </div>
            <div class="text-xs text-slate-400 mb-4">Validated W3C Roles</div>
            <p class="text-xs text-slate-300 leading-relaxed">
              <strong>{snapshot.ariaRoles.staticRoles}</strong> static and <strong>{snapshot.ariaRoles.interactiveRoles}</strong> interactive roles validated with <strong>0 false positive warnings</strong> on correct code.
            </p>
          </div>
          <div class="mt-4 pt-4 border-t border-white/5 text-[11px] text-indigo-300/80">
            &check; {snapshot.diagnostics.declared} compiler diagnostics active
          </div>
        </div>

        <!-- Cross-platform contracts KPI -->
        <div class="p-6 rounded-2xl glass-panel border-t-2 border-t-emerald-400 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-400">Platform Contracts</span>
              <span class="text-[10px] px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">Both Backends</span>
            </div>
            <div class="text-3xl sm:text-4xl font-extrabold text-white mb-1">
              {snapshot.a11yContracts.primitives - snapshot.a11yContracts.uncontracted}/{snapshot.a11yContracts.primitives}
            </div>
            <div class="text-xs text-slate-400 mb-4">Primitives Under Contract</div>
            <p class="text-xs text-slate-300 leading-relaxed">
              Every primitive is pinned by a case that compiles one source through
              <strong>both</strong> backends and states what each has to produce &mdash; including where
              they legitimately differ.
            </p>
          </div>
          <div class="mt-4 pt-4 border-t border-white/5 text-[11px] text-emerald-300/80">
            &check; {snapshot.a11yContracts.covered}/{snapshot.a11yContracts.cases} contract cases holding
          </div>
        </div>
      </div>

      <!-- Section: Web Conformance Details -->
      <section class="mb-16">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-8 rounded-lg bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 font-bold">
            W
          </div>
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">Web Lowering Conformance (hozo_web)</h2>
            <p class="text-xs sm:text-sm text-slate-400">
              Verified by comparing Hozo's compiled CSS directly against Tailwind's official compilation oracle.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-6">
          <div class="p-5 rounded-xl glass-panel">
            <div class="text-xs font-mono text-slate-400 mb-1">Full Catalogue Coverage</div>
            <div class="text-2xl font-bold text-white mb-1">
              {snapshot.catalogue.match.toLocaleString()} / {snapshot.catalogue.comparable.toLocaleString()}
            </div>
            <div class="text-xs text-emerald-400 font-semibold mb-2">
              {pct(snapshot.catalogue.match, snapshot.catalogue.comparable)} Match
            </div>
            <p class="text-xs text-slate-400 leading-relaxed">
              Tailwind's IntelliSense catalogue of 23,286 entries tested across layout, typography, colors, borders, and effects.
            </p>
          </div>

          <div class="p-5 rounded-xl glass-panel">
            <div class="text-xs font-mono text-slate-400 mb-1">Cascade Rule Ordering</div>
            <div class="text-2xl font-bold text-white mb-1">
              {snapshot.candidateSheet.inOrder.toLocaleString()} / {snapshot.candidateSheet.comparable.toLocaleString()}
            </div>
            <div class="text-xs text-emerald-400 font-semibold mb-2">100% In Order</div>
            <p class="text-xs text-slate-400 leading-relaxed">
              Candidate stylesheet order perfectly preserves Tailwind's specificity tiers and breakpoint ascending rules.
            </p>
          </div>

          <div class="p-5 rounded-xl glass-panel">
            <div class="text-xs font-mono text-slate-400 mb-1">Arbitrary Values Support</div>
            <div class="text-2xl font-bold text-white mb-1">
              {snapshot.arbitrary.match.toLocaleString()} / {snapshot.arbitrary.candidates.toLocaleString()}
            </div>
            <div class="text-xs text-sky-400 font-semibold mb-2">
              {pct(snapshot.arbitrary.match, snapshot.arbitrary.candidates)} Fidelity
            </div>
            <p class="text-xs text-slate-400 leading-relaxed">
              Full support for arbitrary value syntax like <code class="text-slate-300">p-[13px]</code>, <code class="text-slate-300">bg-[#0d1117]</code>, and CSS variable bindings.
            </p>
          </div>
        </div>

        <div class="p-5 rounded-xl bg-slate-900/60 border border-white/10 text-xs text-slate-300 leading-relaxed">
          <strong class="text-white">Why exact fidelity matters on Web:</strong> In CSS, utility classes only work reliably when their order, selector structure, and variable declarations mirror the design system. Hozo doesn't invent its own CSS dialect — it lowers JSX primitives to semantic HTML elements with authentic scoped CSS classes.
        </div>
      </section>

      <!-- Section: Native Lowering & Refusal Breakdown -->
      <section class="mb-16">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-bold">
            N
          </div>
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">Native Lowering & Refusal Audit (hozo_native)</h2>
            <p class="text-xs sm:text-sm text-slate-400">
              Lowers to React Native Fabric components and StyleSheet objects. Refusals are diagnosed at build time.
            </p>
          </div>
        </div>

        <!-- Native Verdicts Explanation -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
          <div class="p-4 rounded-xl glass-panel border-l-4 border-l-emerald-400">
            <div class="flex items-center justify-between mb-1">
              <span class="font-bold text-white text-sm">COVERED</span>
              <span class="text-xs font-mono font-bold text-emerald-400">{snapshot.native.covered}</span>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed">
              Hozo emits a native StyleSheet property (flexbox, dimensions, typography, colors, borders, transforms).
            </p>
          </div>

          <div class="p-4 rounded-xl glass-panel border-l-4 border-l-amber-400">
            <div class="flex items-center justify-between mb-1">
              <span class="font-bold text-white text-sm">REFUSED (Known Gaps)</span>
              <span class="text-xs font-mono font-bold text-amber-400">{snapshot.native.refused}</span>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed">
              React Native has no native equivalent. The compiler alerts you with a diagnostic rather than failing silently.
            </p>
          </div>

          <div class="p-4 rounded-xl glass-panel border-l-4 border-l-sky-400">
            <div class="flex items-center justify-between mb-1">
              <span class="font-bold text-white text-sm">NO-OP (Honoured)</span>
              <span class="text-xs font-mono font-bold text-sky-400">{snapshot.native.noOp}</span>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed">
              React Native already performs this by default (e.g. <code class="text-slate-300">box-border</code>). Doing nothing satisfies the contract.
            </p>
          </div>
        </div>

        <!-- Refusal Breakdown Detail Table -->
        <div class="rounded-xl border border-white/10 bg-[#0d1117] overflow-hidden mb-6">
          <div class="p-4 bg-slate-950/60 border-b border-white/10">
            <h3 class="text-sm font-bold text-white flex items-center gap-2">
              <span>Why Candidates Are Refused on Native</span>
              <span class="text-[10px] font-normal px-2 py-0.5 rounded bg-amber-500/10 text-amber-300 border border-amber-500/20">
                Audited against RN types
              </span>
            </h3>
          </div>
          <div class="divide-y divide-white/5 text-xs font-mono">
            <div class="p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:bg-white/[0.02]">
              <div class="flex items-center gap-2">
                <span class="text-amber-400 font-semibold">REFUSED</span>
                <span class="text-white">box-content</span>
              </div>
              <div class="text-slate-400 text-[11px] font-sans">
                React Native Yoga engine enforces <code class="font-mono text-slate-300">box-sizing: border-box</code> universally; content-box is not supported.
              </div>
            </div>
            <div class="p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:bg-white/[0.02]">
              <div class="flex items-center gap-2">
                <span class="text-amber-400 font-semibold">REFUSED</span>
                <span class="text-white">accent-* (accent-indigo-500)</span>
              </div>
              <div class="text-slate-400 text-[11px] font-sans">
                No CSS <code class="font-mono text-slate-300">accent-color</code> equivalent exists for native controls; tint is handled via primitive props.
              </div>
            </div>
            <div class="p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:bg-white/[0.02]">
              <div class="flex items-center gap-2">
                <span class="text-amber-400 font-semibold">REFUSED</span>
                <span class="text-white">caret-* (caret-indigo-500)</span>
              </div>
              <div class="text-slate-400 text-[11px] font-sans">
                Input caret color requires <code class="font-mono text-slate-300">selectionColor</code> on TextInput, not a general style property.
              </div>
            </div>
            <div class="p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:bg-white/[0.02]">
              <div class="flex items-center gap-2">
                <span class="text-amber-400 font-semibold">REFUSED</span>
                <span class="text-white">table, list, inline-*</span>
              </div>
              <div class="text-slate-400 text-[11px] font-sans">
                HTML table & list layouts do not exist in React Native flexbox layout.
              </div>
            </div>
            <div class="p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:bg-white/[0.02]">
              <div class="flex items-center gap-2">
                <span class="text-sky-400 font-semibold">NO-OP</span>
                <span class="text-white">box-border</span>
              </div>
              <div class="text-slate-400 text-[11px] font-sans">
                Honoured by doing nothing: all React Native views already use border-box sizing.
              </div>
            </div>
          </div>
        </div>

        <!-- Refusal Audit Summary Card -->
        <div class="p-4 rounded-xl glass-panel flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs">
          <div>
            <div class="font-bold text-white mb-0.5">Automated Refusal Audit against React Native `.d.ts`</div>
            <p class="text-slate-400">
              Of <strong>{snapshot.refusalAudit.refusals.toLocaleString()}</strong> total refusals audited, <strong>{snapshot.refusalAudit.confirmed.toLocaleString()}</strong> are confirmed impossible from React Native's official type definitions.
            </p>
          </div>
          <div class="flex items-center gap-2 font-mono text-[11px]">
            <span class="px-2.5 py-1 rounded bg-emerald-500/10 text-emerald-300 border border-emerald-500/20">
              {snapshot.refusalAudit.confirmed.toLocaleString()} Confirmed
            </span>
            <span class="px-2.5 py-1 rounded bg-amber-500/10 text-amber-300 border border-amber-500/20">
              {snapshot.refusalAudit.partial} Partial
            </span>
          </div>
        </div>
      </section>

      <!-- Section: StyleX Compatibility -->
      <section class="mb-16">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-8 rounded-lg bg-pink-500/10 border border-pink-500/20 flex items-center justify-center text-pink-400 font-bold">
            X
          </div>
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">StyleX Compatibility & Authoring Parity</h2>
            <p class="text-xs sm:text-sm text-slate-400">
              Full cross-compilation support for Meta's StyleX syntax, both universal and Web-only properties.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-6">
          <div class="p-5 rounded-xl glass-panel">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono text-slate-400">Compiler-Relevant</span>
              <span class="text-xs font-mono font-bold text-pink-400">100%</span>
            </div>
            <div class="text-2xl font-bold text-white mb-1">
              {snapshot.stylex.mappedCompilerRelevant} / {snapshot.stylex.compilerRelevantProperties}
            </div>
            <p class="text-xs text-slate-400 leading-relaxed">
              Ordinary declarations in StyleX's default mode, excluding optional platform adapters.
            </p>
          </div>

          <div class="p-5 rounded-xl glass-panel">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono text-slate-400">Universal Properties</span>
              <span class="text-xs font-mono font-bold text-pink-400">100%</span>
            </div>
            <div class="text-2xl font-bold text-white mb-1">
              {snapshot.stylex.mappedNative} / {snapshot.stylex.nativeProperties}
            </div>
            <p class="text-xs text-slate-400 leading-relaxed">
              Every portable property valid across Web and Native platforms maps directly to Fabric styles.
            </p>
          </div>

          <div class="p-5 rounded-xl glass-panel">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono text-slate-400">Contextual / Interactive</span>
              <span class="text-xs font-mono font-bold text-pink-400">100%</span>
            </div>
            <div class="text-2xl font-bold text-white mb-1">
              {snapshot.stylex.mappedContextual} / {snapshot.stylex.contextualProperties}
            </div>
            <p class="text-xs text-slate-400 leading-relaxed">
              Interactive pseudo-states (:hover, :active, :focus) and contextual container queries.
            </p>
          </div>

          <div class="p-5 rounded-xl glass-panel">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono text-slate-400">Web-Only Extensions</span>
              <span class="text-xs font-mono font-bold text-slate-300">
                {pct(snapshot.stylex.mappedWebOnly, snapshot.stylex.webOnlyProperties)}
              </span>
            </div>
            <div class="text-2xl font-bold text-white mb-1">
              {snapshot.stylex.mappedWebOnly} / {snapshot.stylex.webOnlyProperties}
            </div>
            <p class="text-xs text-slate-400 leading-relaxed">
              Extended CSS longhands, animations, and typography available when compiling for Web.
            </p>
          </div>
        </div>

        <!-- Practical fixtures card -->
        <div class="p-5 rounded-xl bg-slate-900/60 border border-white/10 grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs font-mono">
          <div>
            <span class="text-slate-400 block mb-1">Representative Values</span>
            <strong class="text-white text-base font-bold">{snapshot.stylexValues.covered} / {snapshot.stylexValues.cases}</strong>
            <span class="text-emerald-400 ml-1">({pct(snapshot.stylexValues.covered, snapshot.stylexValues.cases)})</span>
          </div>
          <div>
            <span class="text-slate-400 block mb-1">Authoring Constructs</span>
            <strong class="text-white text-base font-bold">{snapshot.stylexConstructs.covered} / {snapshot.stylexConstructs.cases}</strong>
            <span class="text-emerald-400 ml-1">(100%)</span>
          </div>
          <div>
            <span class="text-slate-400 block mb-1">Scenario Declarations</span>
            <strong class="text-white text-base font-bold">{snapshot.stylexCorpus.covered} / {snapshot.stylexCorpus.cases}</strong>
            <span class="text-emerald-400 ml-1">({pct(snapshot.stylexCorpus.covered, snapshot.stylexCorpus.cases)})</span>
          </div>
        </div>
      </section>

      <!-- Section: Accessibility & ARIA Invariant -->
      <section class="mb-16">
        <div class="flex items-center gap-3 mb-6">
