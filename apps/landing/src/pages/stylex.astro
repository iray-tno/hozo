---
import { DomainNav } from '../components/DomainNav.tsx'
import { Footer } from '../components/Footer.tsx'
import { Navbar } from '../components/Navbar.tsx'
import SiteHead from '../components/SiteHead.astro'
import { compileStylexSamples } from '../components/stylex/compiled.ts'
import {
  StylexConformanceLink,
  StylexIntro,
  StylexMeasured,
  StylexPoints,
  StylexSamplesIntro,
} from '../components/stylex/StylexPage.tsx'
import { StylexSamples } from '../components/stylex/StylexSamples.tsx'
import '../styles/global.css'
import snapshot from '../../../../packages/tailwind-conformance/snapshot.json'

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '')
const samples = compileStylexSamples()
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <SiteHead
      title="StyleX, Compiled — Hozo"
      description="Static StyleX sheets read into the same compiler as Tailwind and lowered to scoped CSS on the Web and StyleSheet objects on iOS and Android; what it does not lower stays with the official StyleX transform."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-yakisugi-950 text-shikkui antialiased min-h-screen relative grid-background">
    <Navbar baseUrl={baseUrl} />

    <main class="pt-24 pb-20 md:pt-32 md:pb-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <DomainNav baseUrl={baseUrl} currentDomain="stylex" />

      <StylexIntro stylex={snapshot.versions.stylex} />
      <StylexSamplesIntro />
      <StylexSamples client:visible samples={samples} />
      <StylexPoints />
      <StylexMeasured numbers={snapshot} />
      <StylexConformanceLink baseUrl={baseUrl} />
    </main>

    <Footer baseUrl={baseUrl} />
  </body>
</html>
