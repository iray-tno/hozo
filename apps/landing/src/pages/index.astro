---
import { CodeShowcase } from '../components/CodeShowcase.tsx'
import { DomainShowcase } from '../components/DomainShowcase.tsx'
import { Footer } from '../components/Footer.tsx'
import { Hero } from '../components/Hero.tsx'
import { Integrations } from '../components/Integrations.tsx'
import { Kumimono } from '../components/Kumimono.tsx'
import { Navbar } from '../components/Navbar.tsx'
import { Philosophy } from '../components/Philosophy.tsx'
import SiteHead from '../components/SiteHead.astro'
import { TryShowcase } from '../components/TryShowcase.tsx'
import { UiShowcase } from '../components/UiShowcase.tsx'
import { loadShowcaseRelease } from '../lib/showcase-release'
import '../styles/global.css'

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '')
// The home page's URL as the canonical tag and the sitemap spell it, with
// the trailing slash. `new URL(BASE_URL, site)` gave `/hozo`, so the
// structured data named a different URL from the page it described.
const homeUrl = new URL(`${baseUrl}/`, Astro.site).href
const showcaseRelease = await loadShowcaseRelease()
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <SiteHead
      title="Hozo — Universal UI Compiler for React Native"
      description="Write React Native. Ship true Semantic Web and native Mobile. A Rust-powered UI compiler with zero runtime on static paths, first-class accessibility, and precomputed styles."
      jsonLd={[
        {
          '@context': 'https://schema.org',
          '@type': 'SoftwareSourceCode',
          name: 'Hozo',
          description:
            'A Rust-powered universal UI compiler and accessibility-first layer for React Native.',
          url: homeUrl,
          codeRepository: 'https://github.com/iray-tno/hozo',
          programmingLanguage: ['Rust', 'TypeScript'],
          runtimePlatform: ['React Native', 'Web'],
          license: 'https://opensource.org/licenses/MIT',
        },
        // The footer's breadcrumb, as structured data (#704).
        {
          '@context': 'https://schema.org',
          '@type': 'BreadcrumbList',
          itemListElement: [
            {
              '@type': 'ListItem',
              position: 1,
              name: 'iray-tno',
              item: 'https://iray-tno.github.io/',
            },
            {
              '@type': 'ListItem',
              position: 2,
              name: 'Hozo',
              item: homeUrl,
            },
          ],
        },
      ]}
    />
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-yakisugi-950 text-shikkui antialiased min-h-screen relative grid-background">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Navbar baseUrl={baseUrl} />
    <main id="main-content" tabindex="-1">
      <Hero baseUrl={baseUrl} />
      <!-- What it is, what it does, why it is better, how to start, then the
           rest: one question per section, in the order a visitor asks them.
           Each section links to the /docs page that goes deeper, rather than
           carrying that depth here. -->
      <CodeShowcase />
      <Philosophy baseUrl={baseUrl} />
      <Integrations baseUrl={baseUrl} />
      <UiShowcase baseUrl={baseUrl} />
      <TryShowcase baseUrl={baseUrl} release={showcaseRelease} />
      <DomainShowcase baseUrl={baseUrl} />
      <Kumimono client:visible baseUrl={baseUrl} />
    </main>
    <Footer baseUrl={baseUrl} />
  </body>
</html>
