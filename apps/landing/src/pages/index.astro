---
import { Accessibility } from '../components/Accessibility.tsx'
import { Architecture } from '../components/Architecture.tsx'
import { CodeShowcase } from '../components/CodeShowcase.tsx'
import { Footer } from '../components/Footer.tsx'
import { Hero } from '../components/Hero.tsx'
import { Integrations } from '../components/Integrations.tsx'
import { Navbar } from '../components/Navbar.tsx'
import { Philosophy } from '../components/Philosophy.tsx'
import SiteHead from '../components/SiteHead.astro'
import { StaticCard } from '../components/StaticCard.tsx'
import { TieredStyles } from '../components/TieredStyles.tsx'
import '../styles/global.css'

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <SiteHead
      title="Hozo — Universal UI Compiler for React Native"
      description="Write React Native. Ship true Semantic Web and native Mobile. A Rust-powered UI compiler with zero runtime on static paths, first-class accessibility, and precomputed styles."
      jsonLd={{
        '@context': 'https://schema.org',
        '@type': 'SoftwareSourceCode',
        name: 'Hozo',
        description:
          'A Rust-powered universal UI compiler and accessibility-first layer for React Native.',
        url: new URL(import.meta.env.BASE_URL, Astro.site).href,
        codeRepository: 'https://github.com/iray-tno/hozo',
        programmingLanguage: ['Rust', 'TypeScript'],
        runtimePlatform: ['React Native', 'Web'],
        license: 'https://opensource.org/licenses/MIT',
      }}
    />
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-yakisugi-950 text-shikkui antialiased min-h-screen relative grid-background">
    <Navbar baseUrl={baseUrl} />
    <main>
      <Hero baseUrl={baseUrl} />
      <Philosophy />
      <TieredStyles />
      <!-- No `client:` directive, deliberately. Astro renders this at
           build time and ships no JavaScript for it; see StaticCard.tsx. -->
      <div class="mx-auto max-w-3xl px-6 py-12">
        <StaticCard />
      </div>
      <CodeShowcase />
      <Accessibility />
      <Integrations baseUrl={baseUrl} />
      <Architecture />
    </main>
    <Footer baseUrl={baseUrl} />
  </body>
</html>
