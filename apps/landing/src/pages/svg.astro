---
import { DomainNav } from '../components/DomainNav.tsx'
import { Footer } from '../components/Footer.tsx'
import { Navbar } from '../components/Navbar.tsx'
import SiteHead from '../components/SiteHead.astro'
import { FilterStudio } from '../components/svg/FilterStudio.tsx'
import {
  SvgAuthoring,
  SvgFilterCoverage,
  SvgIntro,
  SvgPoints,
  SvgSpecimens,
} from '../components/svg/SvgPage.tsx'
import '../styles/global.css'
import snapshot from '../../../../packages/tailwind-conformance/snapshot.json'

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <SiteHead
      title="Universal SVG & Filters — Hozo"
      description="One Svg namespace for Web and React Native: the browser's own SVG elements on the Web, react-native-svg on iOS and Android, with the filter set both platforms draw."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-yakisugi-950 text-shikkui antialiased min-h-screen relative grid-background">
    <Navbar baseUrl={baseUrl} />

    <main class="pt-24 pb-20 md:pt-32 md:pb-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <DomainNav baseUrl={baseUrl} currentDomain="svg" />

      <SvgIntro />
      <FilterStudio client:visible />
      <SvgSpecimens />
      <SvgPoints />
      <SvgFilterCoverage web={snapshot.svgFilterWeb} native={snapshot.svgFilterNative} />
      <SvgAuthoring />
    </main>

    <Footer baseUrl={baseUrl} />
  </body>
</html>
