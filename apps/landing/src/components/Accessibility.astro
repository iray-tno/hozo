---
---
<section id="accessibility" class="py-24 border-t border-hinoki/15 relative bg-gradient-to-b from-yakisugi-950/70 via-yakisugi-900/40 to-transparent">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 flex flex-col items-center">
      <span class="text-xs font-bold uppercase tracking-widest text-hinoki mb-3 block">Accessibility-First</span>
      <h3 class="text-3xl sm:text-5xl font-extrabold text-shikkui tracking-tight mb-4">
        Accessible by Structure, Not Afterthought
      </h3>
      <p class="text-shikkui-muted text-base sm:text-lg leading-relaxed">
        Accessibility isn't decorative trim—it is the foundational joinery of software. Hozo enforces W3C ARIA conformance at compile time and provides seamless cross-platform keyboard and focus behaviors.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-5xl mx-auto items-stretch">
      <!-- Feature 1: Compile-time Diagnostics -->
      <div class="p-8 rounded-2xl timber-panel border border-hinoki/20 flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-bengara/15 border border-bengara/30 flex items-center justify-center text-bengara mb-6">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <h4 class="text-xl font-bold text-shikkui mb-3">Compile-Time ARIA Verification</h4>
          <p class="text-stone-400 text-sm leading-relaxed mb-6">
            Directly derived from the machine-readable W3C specification via <code class="text-shikkui-muted text-xs">aria-query</code>. Catches invalid roles, missing attributes, and malformed states during compilation before they ship to production.
          </p>

          <div class="p-4 rounded-xl bg-bengara/10 border border-bengara/30 font-mono text-xs text-shikkui">
            <div class="text-bengara font-semibold mb-1">&#x2715; Hozo Diagnostic [A11Y-004]</div>
            <div class="text-stone-300">Element with role="checkbox" requires aria-checked (or accessibilityState.checked)</div>
          </div>
        </div>

        <ul class="mt-6 text-xs text-stone-400 space-y-2 border-t border-hinoki/10 pt-4">
          <li class="flex items-center gap-2">
            <span class="text-tatami-light">&#x2713;</span> Automatic semantic mapping (<code class="text-shikkui-muted">header &rarr; heading</code>, <code class="text-shikkui-muted">search &rarr; searchbox</code>)
          </li>
          <li class="flex items-center gap-2">
            <span class="text-tatami-light">&#x2713;</span> Abstract role warnings (<code class="text-shikkui-muted">role="widget"</code>)
          </li>
        </ul>
      </div>

      <!-- Feature 2: @hozo/behaviors Primitives -->
      <div class="p-8 rounded-2xl timber-panel border border-hinoki/20 flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-hinoki/15 border border-hinoki/30 flex items-center justify-center text-hinoki mb-6">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" />
            </svg>
          </div>
          <h4 class="text-xl font-bold text-shikkui mb-3">Accessible Behaviors (@hozo/behaviors)</h4>
          <p class="text-stone-400 text-sm leading-relaxed mb-6">
            Smooth, dependable interaction mechanics across Web and Native: focus management, keyboard navigation, roving tabindex, and collision-aware anchoring.
          </p>

          <div class="grid grid-cols-2 gap-3 font-mono text-xs">
            <div class="p-3 rounded-lg bg-yakisugi-950/80 border border-hinoki/15 text-shikkui-muted flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-hinoki"></span> Dialog & Modal
            </div>
            <div class="p-3 rounded-lg bg-yakisugi-950/80 border border-hinoki/15 text-shikkui-muted flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-tatami-light"></span> Combobox & Listbox
            </div>
            <div class="p-3 rounded-lg bg-yakisugi-950/80 border border-hinoki/15 text-shikkui-muted flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-bengara"></span> Tabs & Panels
            </div>
            <div class="p-3 rounded-lg bg-yakisugi-950/80 border border-hinoki/15 text-shikkui-muted flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-hinoki-light"></span> Menu & Toolbar
            </div>
          </div>
        </div>

        <ul class="mt-6 text-xs text-stone-400 space-y-2 border-t border-hinoki/10 pt-4">
          <li class="flex items-center gap-2">
            <span class="text-tatami-light">&#x2713;</span> WAI-ARIA compliant keyboard listeners
          </li>
          <li class="flex items-center gap-2">
            <span class="text-tatami-light">&#x2713;</span> Deterministic focus restoration on dismissal
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
