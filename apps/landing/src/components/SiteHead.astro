---
// The part of every page's <head> that says what the page is.
//
// Each page used to write its own, and each carried a title and a
// description and nothing else: no canonical URL, no Open Graph or Twitter
// card, so a link to the site shared anywhere rendered as a bare URL and a
// crawler had nothing to deduplicate `/hozo` against `/hozo/` with. One
// component, so the three pages cannot disagree about what a page needs.
//
// The image is the hero section drawn as a card (`scripts/og-image.mjs`),
// the same one for every page: the pages share a title prefix and a site,
// and a per-page card would be three pictures of one headline.
interface Props {
  title: string
  description: string
  /** Keep the page out of search results (the MDX probe). */
  noindex?: boolean
  /** Structured data, emitted as JSON-LD. */
  jsonLd?: Record<string, unknown>
}

const { title, description, noindex = false, jsonLd } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const canonical = new URL(Astro.url.pathname, Astro.site).href
// Absolute: a crawler fetching the card resolves nothing against the page.
const image = new URL(`${base}/og-image.png`, Astro.site).href
const imageAlt = 'Hozo: Write React Native. Ship Semantic Web & Native UI.'
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Hozo" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
<link rel="sitemap" href={`${base}/sitemap.xml`} />
{jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
