---
// The part of every page's <head> that says what the page is.
//
// Each page used to write its own, and each carried a title and a
// description and nothing else: no canonical URL, no Open Graph or Twitter
// card, so a link to the site shared anywhere rendered as a bare URL and a
// crawler had nothing to deduplicate `/hozo` against `/hozo/` with. One
// component, so the three pages cannot disagree about what a page needs.
//
// No `og:image`: there is no artwork yet, and a placeholder image is worse
// than the text-only card platforms fall back to.
interface Props {
  title: string
  description: string
  /** Keep the page out of search results (the MDX probe). */
  noindex?: boolean
  /** Structured data, emitted as JSON-LD. */
  jsonLd?: Record<string, unknown>
}

const { title, description, noindex = false, jsonLd } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const canonical = new URL(Astro.url.pathname, Astro.site).href
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Hozo" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_US" />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<link rel="sitemap" href={`${base}/sitemap.xml`} />
{jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
