---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '')
const homeUrl = baseUrl ? `${baseUrl}/` : '/'
---
<header class="fixed top-0 left-0 right-0 z-50 border-b border-hinoki/20 bg-yakisugi-950/90 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href={homeUrl} class="flex items-center gap-2 group">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-hinoki-light via-hinoki to-kuri flex items-center justify-center p-0.5 shadow-md shadow-hinoki/10 group-hover:scale-105 transition-transform">
          <div class="w-full h-full bg-yakisugi-950 rounded-[6px] flex items-center justify-center font-bold text-shikkui tracking-tighter text-sm">
            HZ
          </div>
        </div>
        <span class="font-extrabold text-xl tracking-tight text-shikkui">Hozo</span>
        <span class="text-xs px-2 py-0.5 rounded-full bg-hinoki/10 text-hinoki border border-hinoki/25 font-medium">
          v0.0.0 prototype
        </span>
      </a>
    </div>

    <nav class="hidden md:flex items-center gap-8 text-sm text-shikkui-muted font-medium">
      <a href={`${baseUrl}/conformance/`} class="text-hinoki hover:text-hinoki-light font-semibold flex items-center gap-1.5 transition-colors">
        <span class="w-2 h-2 rounded-full bg-hinoki"></span>
        Conformance
      </a>
      <a href={`${baseUrl}/repl/`} class="text-bengara hover:text-bengara-hover font-semibold flex items-center gap-1.5 transition-colors">
        <span class="w-2 h-2 rounded-full bg-bengara"></span>
        REPL
      </a>
      <a href={`${baseUrl}/storybook/`} class="text-tatami-light hover:text-shikkui font-semibold flex items-center gap-1.5 transition-colors">
        <span class="w-2 h-2 rounded-full bg-tatami"></span>
        Storybook
      </a>
      <a href={`${baseUrl}/reports/`} class="text-hinoki-light hover:text-shikkui font-semibold flex items-center gap-1.5 transition-colors">
        <span class="w-2 h-2 rounded-full bg-hinoki-light"></span>
        Reports
      </a>
      <a href={`${homeUrl}#philosophy`} class="hover:text-shikkui transition-colors">Principles</a>
      <a href={`${homeUrl}#tiered-styles`} class="hover:text-shikkui transition-colors">Tiered Styles</a>
      <a href={`${homeUrl}#code-showcase`} class="hover:text-shikkui transition-colors">Code Comparison</a>
      <a href={`${homeUrl}#accessibility`} class="hover:text-shikkui transition-colors">Accessibility</a>
      <a href={`${homeUrl}#integrations`} class="hover:text-shikkui transition-colors">Integrations</a>
      <a href={`${homeUrl}#architecture`} class="hover:text-shikkui transition-colors">Architecture</a>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href={`${baseUrl}/repl/`}
        class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-bengara hover:bg-bengara-hover text-shikkui shadow-sm transition-all md:hidden"
      >
        <span>REPL</span>
      </a>
      <a
        href="https://github.com/iray-tno/hozo"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-yakisugi-800 hover:bg-yakisugi-700 text-shikkui border border-hinoki/20 transition-all hover:border-hinoki/40"
      >
        <svg class="w-4 h-4 fill-current text-hinoki" viewBox="0 0 24 24">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        <span>GitHub</span>
      </a>
    </div>
  </div>
</header>
