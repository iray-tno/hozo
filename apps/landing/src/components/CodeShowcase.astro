---
---
<section id="code-showcase" class="py-24 border-t border-hinoki/15 relative bg-yakisugi-950/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 flex flex-col items-center">
      <span class="text-xs font-bold uppercase tracking-widest text-hinoki mb-3 block">Side-by-Side Lowering</span>
      <h3 class="text-3xl sm:text-5xl font-extrabold text-shikkui tracking-tight mb-4">
        One Source, Two True Primitives
      </h3>
      <p class="text-shikkui-muted text-base sm:text-lg leading-relaxed">
        From a single universal component, Hozo lowers directly to genuine Semantic HTML and CSS on the Web,
        and native Fabric and StyleSheet on React Native. Zero wrapper runtimes.
      </p>
    </div>

    <!-- Code Comparison Box -->
    <div class="rounded-2xl border border-hinoki/20 bg-yakisugi-950 overflow-hidden shadow-2xl max-w-6xl mx-auto">
      <!-- Top Bar: Source Input -->
      <div class="border-b border-hinoki/15 p-4 sm:p-6 bg-yakisugi-900/80">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-bengara/80"></span>
            <span class="w-3 h-3 rounded-full bg-hinoki/80"></span>
            <span class="w-3 h-3 rounded-full bg-tatami-light/80"></span>
            <span class="text-xs font-mono text-stone-400 ml-2">Universal Source: NotificationCard.tsx</span>
          </div>
          <span class="text-xs px-2.5 py-0.5 rounded bg-hinoki/10 text-hinoki border border-hinoki/30 font-mono">
            React Native / @hozo/core
          </span>
        </div>
        <pre class="font-mono text-xs sm:text-sm text-shikkui-muted overflow-x-auto leading-relaxed"><code><span class="text-hinoki">import</span> &#123; <span class="text-shikkui">View</span>, <span class="text-shikkui">Heading</span>, <span class="text-shikkui">Paragraph</span>, <span class="text-shikkui">Button</span> &#125; <span class="text-hinoki">from</span> <span class="text-tatami-light">'@hozo/core'</span>

<span class="text-hinoki">export function</span> <span class="text-hinoki-light">NotificationCard</span>(&#123; <span class="text-shikkui-muted">title</span>, <span class="text-shikkui-muted">message</span>, <span class="text-shikkui-muted">onDismiss</span> &#125;) &#123;
  <span class="text-hinoki">return</span> (
    &lt;<span class="text-shikkui">View</span> <span class="text-stone-400">role</span>=<span class="text-tatami-light">"alert"</span> <span class="text-stone-400">className</span>=<span class="text-tatami-light">"p-6 rounded-2xl bg-yakisugi-800 border border-hinoki/20"</span>&gt;
      &lt;<span class="text-shikkui">Heading</span> <span class="text-stone-400">level</span>=&#123;<span class="text-bengara">2</span>&#125; <span class="text-stone-400">className</span>=<span class="text-tatami-light">"text-xl font-bold text-shikkui mb-2"</span>&gt;&#123;title&#125;&lt;/<span class="text-shikkui">Heading</span>&gt;
      &lt;<span class="text-shikkui">Paragraph</span> <span class="text-stone-400">className</span>=<span class="text-tatami-light">"text-stone-400 text-sm mb-4"</span>&gt;&#123;message&#125;&lt;/<span class="text-shikkui">Paragraph</span>&gt;
      &lt;<span class="text-shikkui">Button</span> <span class="text-stone-400">onPress</span>=&#123;onDismiss&#125; <span class="text-stone-400">className</span>=<span class="text-tatami-light">"bg-bengara px-4 py-2 rounded-lg text-shikkui font-medium"</span>&gt;
        Dismiss
      &lt;/<span class="text-shikkui">Button</span>&gt;
    &lt;/<span class="text-shikkui">View</span>&gt;
  )
&#125;</code></pre>
      </div>

      <!-- Split Bottom: Web vs Native Output -->
      <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-hinoki/15">
        <!-- Left: Web Output -->
        <div class="p-4 sm:p-6 bg-yakisugi-950/90">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold text-hinoki flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>
              Web Lowering (DOM + CSS + W3C ARIA)
            </span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-hinoki/10 text-hinoki-light border border-hinoki/20">
              No RNW Wrapper
            </span>
          </div>
          <pre class="font-mono text-xs text-shikkui-muted overflow-x-auto leading-relaxed"><code><span class="text-stone-500">// Semantic HTML & scoped CSS classes</span>
<span class="text-hinoki">export function</span> <span class="text-hinoki-light">NotificationCard</span>(&#123; <span class="text-shikkui-muted">title</span>, <span class="text-shikkui-muted">message</span>, <span class="text-shikkui-muted">onDismiss</span> &#125;) &#123;
  <span class="text-hinoki">return</span> (
    &lt;<span class="text-tatami-light">div</span> <span class="text-hinoki">role</span>=<span class="text-tatami-light">"alert"</span> <span class="text-hinoki">class</span>=<span class="text-tatami-light">"hz-p-6 hz-rounded-2xl hz-bg-yakisugi-800 hz-border"</span>&gt;
      &lt;<span class="text-tatami-light">h2</span> <span class="text-hinoki">class</span>=<span class="text-tatami-light">"hz-text-xl hz-font-bold hz-text-shikkui hz-mb-2"</span>&gt;&#123;title&#125;&lt;/<span class="text-tatami-light">h2</span>&gt;
      &lt;<span class="text-tatami-light">p</span> <span class="text-hinoki">class</span>=<span class="text-tatami-light">"hz-text-stone-400 hz-text-sm hz-mb-4"</span>&gt;&#123;message&#125;&lt;/<span class="text-tatami-light">p</span>&gt;
      &lt;<span class="text-tatami-light">button</span> <span class="text-hinoki">type</span>=<span class="text-tatami-light">"button"</span> <span class="text-hinoki">onClick</span>=&#123;onDismiss&#125; <span class="text-hinoki">class</span>=<span class="text-tatami-light">"hz-bg-bengara hz-px-4 hz-py-2 hz-text-shikkui"</span>&gt;
        Dismiss
      &lt;/<span class="text-tatami-light">button</span>&gt;
    &lt;/<span class="text-tatami-light">div</span>&gt;
  )
&#125;</code></pre>
        </div>

        <!-- Right: Native Output -->
        <div class="p-4 sm:p-6 bg-yakisugi-950/90">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold text-tatami-light flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
              Native Lowering (Fabric / StyleSheet)
            </span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-tatami/15 text-tatami-light border border-tatami/30">
              Fabric Native
            </span>
          </div>
          <pre class="font-mono text-xs text-shikkui-muted overflow-x-auto leading-relaxed"><code><span class="text-stone-500">// React Native primitives + precomputed styles</span>
<span class="text-hinoki">export function</span> <span class="text-hinoki-light">NotificationCard</span>(&#123; <span class="text-shikkui-muted">title</span>, <span class="text-shikkui-muted">message</span>, <span class="text-shikkui-muted">onDismiss</span> &#125;) &#123;
  <span class="text-hinoki">return</span> (
    &lt;<span class="text-shikkui">View</span> <span class="text-stone-400">accessibilityRole</span>=<span class="text-tatami-light">"alert"</span> <span class="text-stone-400">style</span>=&#123;styles.card&#125;&gt;
      &lt;<span class="text-shikkui">Text</span> <span class="text-stone-400">accessibilityRole</span>=<span class="text-tatami-light">"header"</span> <span class="text-stone-400">style</span>=&#123;styles.title&#125;&gt;&#123;title&#125;&lt;/<span class="text-shikkui">Text</span>&gt;
      &lt;<span class="text-shikkui">Text</span> <span class="text-stone-400">style</span>=&#123;styles.body&#125;&gt;&#123;message&#125;&lt;/<span class="text-shikkui">Text</span>&gt;
      &lt;<span class="text-shikkui">Pressable</span> <span class="text-stone-400">accessibilityRole</span>=<span class="text-tatami-light">"button"</span> <span class="text-stone-400">onPress</span>=&#123;onDismiss&#125; <span class="text-stone-400">style</span>=&#123;styles.button&#125;&gt;
        &lt;<span class="text-shikkui">Text</span> <span class="text-stone-400">style</span>=&#123;styles.buttonText&#125;&gt;Dismiss&lt;/<span class="text-shikkui">Text</span>&gt;
      &lt;/<span class="text-shikkui">Pressable</span>&gt;
    &lt;/<span class="text-shikkui">View</span>&gt;
  )
&#125;</code></pre>
        </div>
      </div>
    </div>
  </div>
</section>
