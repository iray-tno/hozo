<footer class="py-16 border-t border-hinoki/20 bg-yakisugi-950 text-stone-400 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-hinoki-light to-kuri flex items-center justify-center p-0.5 shadow-md">
          <div class="w-full h-full bg-yakisugi-950 rounded-[5px] flex items-center justify-center font-bold text-shikkui tracking-tighter text-xs">
            HZ
          </div>
        </div>
        <span class="font-bold text-shikkui tracking-tight">Hozo</span>
        <span class="text-xs text-stone-500">| Universal UI Compiler</span>
      </div>

      <div class="flex items-center gap-6 text-xs font-medium">
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/conformance/`} class="hover:text-hinoki text-shikkui-muted transition-colors">Conformance Matrix</a>
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/storybook/`} class="hover:text-tatami-light text-shikkui-muted transition-colors">Storybook</a>
        <a href="https://github.com/iray-tno/hozo" target="_blank" class="hover:text-shikkui transition-colors">GitHub Repository</a>
        <a href="https://github.com/iray-tno/hozo/blob/main/docs/proposal.md" target="_blank" class="hover:text-shikkui transition-colors">Proposal (JP)</a>
        <a href="https://github.com/iray-tno/hozo/blob/main/LICENSE" target="_blank" class="hover:text-shikkui transition-colors">MIT License</a>
      </div>

      <div class="text-xs text-stone-500">
        &copy; {new Date().getFullYear()} Hozo Contributors. MIT Licensed.
      </div>
    </div>
  </div>
</footer>
