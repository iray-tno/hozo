---
---
<section id="architecture" class="py-24 border-t border-hinoki/15 relative bg-gradient-to-b from-transparent via-yakisugi-950/60 to-transparent">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 flex flex-col items-center">
      <span class="text-xs font-bold uppercase tracking-widest text-hinoki mb-3 block">Internal Design</span>
      <h3 class="text-3xl sm:text-5xl font-extrabold text-shikkui tracking-tight mb-4">
        Compiler Architecture
      </h3>
      <p class="text-shikkui-muted text-base sm:text-lg leading-relaxed">
        High-performance AST parsing powered by Rust and <a href="https://oxc.rs/" target="_blank" class="text-hinoki hover:underline font-semibold">oxc</a>. A platform-independent Intermediate Representation (IR) guarantees symmetric compilation to Web and Native.
      </p>
    </div>

    <!-- Architecture Pipeline Diagram -->
    <div class="max-w-4xl mx-auto p-8 rounded-2xl timber-panel-glow border border-hinoki/30">
      <div class="space-y-6">
        <!-- Level 1: Input -->
        <div class="p-4 rounded-xl bg-yakisugi-900 border border-hinoki/20 text-center">
          <div class="text-xs font-mono uppercase tracking-widest text-stone-400 mb-1">Source Code</div>
          <div class="text-base font-bold text-shikkui">React Native TSX / @hozo/core Primitives</div>
        </div>

        <div class="flex justify-center text-hinoki">
          <svg class="w-6 h-6 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>
        </div>

        <!-- Level 2: Rust Compiler Core -->
        <div class="p-6 rounded-xl bg-yakisugi-950/90 border border-hinoki/30">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono font-bold text-hinoki uppercase tracking-widest">Rust Compiler Engine</span>
            <span class="text-xs font-mono px-2.5 py-0.5 rounded bg-hinoki/15 text-hinoki-light border border-hinoki/30">hozo_parser & hozo_ir</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-center">
            <div class="p-3 rounded-lg bg-yakisugi-900 border border-hinoki/15 text-xs">
              <div class="font-bold text-hinoki mb-1">Style IR</div>
              <div class="text-stone-400 text-[11px]">Tailwind & static style extraction</div>
            </div>
            <div class="p-3 rounded-lg bg-yakisugi-900 border border-hinoki/15 text-xs">
              <div class="font-bold text-tatami-light mb-1">Semantic IR</div>
              <div class="text-stone-400 text-[11px]">Roles, elements & state transitions</div>
            </div>
            <div class="p-3 rounded-lg bg-yakisugi-900 border border-hinoki/15 text-xs">
              <div class="font-bold text-bengara mb-1">Diagnostics</div>
              <div class="text-stone-400 text-[11px]">W3C ARIA static validation</div>
            </div>
          </div>
        </div>

        <div class="flex justify-center text-hinoki">
          <svg class="w-6 h-6 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>
        </div>

        <!-- Level 3: Platform Lowering -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Web Backend -->
          <div class="p-5 rounded-xl bg-yakisugi-900/90 border border-hinoki/30">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-hinoki-light">Web Backend</span>
              <span class="text-[10px] font-mono text-stone-400">crates/hozo_web</span>
            </div>
            <div class="text-sm font-semibold text-shikkui mb-2">Semantic DOM + CSS + ARIA</div>
            <p class="text-xs text-stone-400">
              Pure semantic HTML tags (&lt;h1&gt;, &lt;p&gt;, &lt;button&gt;), precomputed CSS classes, zero runtime.
            </p>
          </div>

          <!-- Native Backend -->
          <div class="p-5 rounded-xl bg-yakisugi-900/90 border border-tatami/40">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-tatami-light">Native Backend</span>
              <span class="text-[10px] font-mono text-stone-400">crates/hozo_native</span>
            </div>
            <div class="text-sm font-semibold text-shikkui mb-2">React Native Fabric</div>
            <p class="text-xs text-stone-400">
              View, Text, Pressable, and precomputed StyleSheet objects integrated into the Metro AST.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
