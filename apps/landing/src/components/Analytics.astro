---
// Google Analytics 4 and Microsoft Clarity. Production builds only, so
// `astro dev` and local previews never report a visit. Every tag is marked
// `data-analytics`: the build check exempts exactly those from its "this
// page ships no JavaScript" assertions -- the claim is about Hozo's
// components, not about the site's measurement -- and pins what they are,
// so a script cannot ride in under the same mark.
const GA_ID = 'G-5B728NQBSP'
const CLARITY_ID = 'yihnef0iol'
const analytics = import.meta.env.PROD
---

{
  analytics && (
    <>
      <script
        is:inline
        async
        data-analytics
        src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}
      />
      <script
        is:inline
        data-analytics
        set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',${JSON.stringify(GA_ID)});`}
      />
      <script
        is:inline
        data-analytics
        set:html={`(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script",${JSON.stringify(CLARITY_ID)});`}
      />
    </>
  )
}
