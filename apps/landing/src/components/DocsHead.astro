---
// Starlight's own <head> for the /docs pages, plus what every other page on
// the site carries -- the share card, the crawler directives and the
// measurement -- so the build check's rules hold here too.
import Default from '@astrojs/starlight/components/Head.astro'
import { GOOGLE_SITE_VERIFICATION, ROBOTS_INDEX } from '../lib/site-meta'
import Analytics from './Analytics.astro'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const image = new URL(`${base}/og-image.png`, Astro.site).href
---

<Default />
<meta name="robots" content={ROBOTS_INDEX} />
<meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
<meta property="og:image" content={image} />
<meta name="twitter:image" content={image} />
<Analytics />
<script>
  // Pages without listings need neither the React renderer nor clipboard code.
  const enhanceCode = () => {
    if (document.querySelector('[data-hozo-docs-code]'))
      void import('../scripts/docs-code.ts').then(({ hydrateDocsCode }) => hydrateDocsCode())
  }
  enhanceCode()
  document.addEventListener('astro:page-load', enhanceCode)
</script>
<!-- The landing's type, which src/styles/docs.css names. -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
  rel="stylesheet"
/>
