---
// A @hozo/ui component, live: the page hydrates the example as an island
// so a reader can press, type and open it here, then reads its source
// below. The preview is server-rendered first, so it is there before the
// script arrives and without one.
//
// Under the preview, one line on what React Native makes of the same look.
// It is the compiler's verdict on the component's classes
// (`scripts/ui-native-status.mjs`): the classes it lists
// have no effect there, the class props it lists are not applied there at
// all (`scripts/ui-native-unapplied.mjs`), and anything it does not list may
// still behave
// differently for reasons classes do not show. The components overview
// says so to the reader.
//
// Below that, when the deploy fetched them, the demo's screenshots from the
// last Android and iOS runs on main (`scripts/fetch-native-screenshots.mjs`),
// which show what the verdict cannot. A build without them shows neither an
// image nor a gap, and one platform shows without the other.
import DocsCodeBlock from './DocsCodeBlock.astro'
import status from '../../data/ui-native-status.json'
import {
  type NativeScreenshotsByPlatform,
  platformNames,
  platforms,
} from '../../lib/native-screenshots.ts'
import { UiStage } from './UiStage.tsx'

interface Props {
  /** The example's source, as the page imports it with `?raw`. */
  source: string
  /** The file name the source is shown under. */
  file: string
}

const { source, file } = Astro.props
type Finding = { className: string; reason: string }
const slug = Astro.url.pathname.replace(/\/$/, '').split('/').pop() ?? ''
const native = (
  status as Record<string, { missing: Finding[]; cosmetic: Finding[]; unapplied: string[] }>
)[slug]
// The compiler writes code in backticks; show it as code.
const pieces = (reason: string) => reason.split('`').map((text, at) => ({ text, code: at % 2 === 1 }))
const plural = (count: number, word: string) => `${count} ${word}${count === 1 ? '' : 'es'}`
// Present only in a build that ran the fetch; a glob, so its absence is not
// an error.
const screenshots =
  Object.values(
    import.meta.glob<NativeScreenshotsByPlatform>('../../data/native-screenshots.json', {
      eager: true,
      import: 'default',
    }),
  )[0] ?? {}
const shots = platforms.flatMap((platform) => {
  const run = screenshots[platform]
  const shot = run?.pages[slug]
  return run && shot ? [{ platform, run, shot }] : []
})
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
// The page's own title ("Date Picker"), so each image says which demo it is
// of without the page around it.
const component = Astro.locals.starlightRoute?.entry.data.title ?? slug
---

<figure class="not-content hozo-ui-example">
  <UiStage><slot /></UiStage>
</figure>

{
  native && (
    <div
      class="hozo-ui-native"
      data-native-missing={native.missing.length}
      data-native-unapplied={native.unapplied.length}
    >
      {native.missing.length === 0 && native.unapplied.length === 0 ? (
        <p>
          <strong>React Native:</strong> no class in this look is Web-only
          {native.cosmetic.length > 0 &&
            `, apart from ${plural(native.cosmetic.length, 'class')} for a cursor or a CSS transition`}
          .
        </p>
      ) : (
        <details>
          <summary>
            <strong>React Native:</strong>{' '}
            {[
              native.unapplied.length > 0 &&
                `${native.unapplied.length === 1 ? 'one class prop' : `${native.unapplied.length} class props`} of this look ${native.unapplied.length === 1 ? 'is' : 'are'} not applied there yet`,
              native.missing.length > 0 &&
                `${plural(native.missing.length, 'class')} ${native.missing.length === 1 ? 'has' : 'have'} no effect there`,
              native.cosmetic.length > 0 &&
                `${plural(native.cosmetic.length, 'class')} for a cursor or a CSS transition ${native.cosmetic.length === 1 ? 'does' : 'do'} not apply`,
            ]
              .filter(Boolean)
              .join('; ')}
            .
          </summary>
          {native.unapplied.length > 0 && (
            <p data-native-unapplied-props>
              Not applied on React Native yet: the component's Native half accepts{' '}
              {native.unapplied.map((prop, at) => (
                <>
                  {at > 0 && ', '}
                  <code>{prop}</code>
                </>
              ))}{' '}
              and does not use {native.unapplied.length === 1 ? 'it' : 'them'}, so that part of
              the look is missing there whatever its classes are.
            </p>
          )}
          {native.missing.length > 0 && (
            <ul>
              {native.missing.map(({ className, reason }) => (
                <li>
                  <code>{className}</code>:{' '}
                  {pieces(reason).map(({ text, code }) => (code ? <code>{text}</code> : text))}
                </li>
              ))}
            </ul>
          )}
        </details>
      )}
    </div>
  )
}

{
  shots.length > 0 && (
    <details class="hozo-ui-native-shot">
      <summary>
        {shots.some(({ shot }) => shot.status === 'failed')
          ? `On ${shots
              .filter(({ shot }) => shot.status === 'failed')
              .map(({ platform }) => platformNames[platform])
              .join(' and ')}, this demo threw an error`
          : `Screenshot${shots.length > 1 ? 's' : ''} on ${shots.map(({ platform }) => platformNames[platform]).join(' and ')}`}
      </summary>
      <div class="hozo-ui-native-shots">
        {shots.map(({ platform, run, shot }) => (
          <figure data-native-screenshot={shot.status} data-platform={platform}>
            <img
              src={`${base}/native-screenshots/${platform}/${shot.image}`}
              alt={
                shot.status === 'failed'
                  ? `The error the ${component} demo threw on ${platformNames[platform]}`
                  : `The ${component} demo on ${platformNames[platform]}`
              }
              width={shot.width}
              height={shot.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              {platformNames[platform]} (<a href={run.runUrl}>{run.takenAt.slice(0, 10)}</a>,{' '}
              <a href={`https://github.com/iray-tno/hozo/commit/${run.commit}`}>
                <code>{run.commit.slice(0, 7)}</code>
              </a>
              )
            </figcaption>
          </figure>
        ))}
      </div>
    </details>
  )
}

<DocsCodeBlock code={source.trim()} lang="tsx" title={file} />

<style>
  .hozo-ui-example {
    margin-block: 1.5rem 0.5rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.5rem;
    overflow: hidden;
  }
  .hozo-ui-native {
    margin-block: 0 1rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .hozo-ui-native ul {
    margin-block-start: 0.5rem;
  }
  .hozo-ui-native-shot {
    margin-block: 0 1rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .hozo-ui-native-shots {
    display: flex;
    gap: 1rem;
    margin-block-start: 0.5rem;
  }
  /* Side by side even on a phone: two full-width phone screenshots stacked
     are two screens of scrolling for one comparison. */
  .hozo-ui-native-shots figure {
    flex: 0 1 270px;
    min-width: 0;
    margin: 0;
  }
  .hozo-ui-native-shots img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.5rem;
  }
  .hozo-ui-native-shots figcaption {
    margin-block-start: 0.25rem;
  }
</style>
