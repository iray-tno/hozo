---
// A @hozo/ui component, live: the page hydrates the example as an island
// so a reader can press, type and open it here, then reads its source
// below. The preview is server-rendered first, so it is there before the
// script arrives and without one.
//
// Under the preview, one line on what React Native makes of the same look.
// It is the compiler's verdict on the component's classes
// (`scripts/ui-native-status.mjs`), not a screenshot: the classes it lists
// have no effect there, the class props it lists are not applied there at
// all (`scripts/ui-native-unapplied.mjs`), and anything it does not list may
// still behave
// differently for reasons classes do not show. The components overview
// says so to the reader.
import { Code } from '@astrojs/starlight/components'
import status from '../../data/ui-native-status.json'
import { UiStage } from './UiStage.tsx'

interface Props {
  /** The example's source, as the page imports it with `?raw`. */
  source: string
  /** The file name the source is shown under. */
  file: string
}

const { source, file } = Astro.props
type Finding = { className: string; reason: string }
const slug = Astro.url.pathname.replace(/\/$/, '').split('/').pop() ?? ''
const native = (
  status as Record<string, { missing: Finding[]; cosmetic: Finding[]; unapplied: string[] }>
)[slug]
// The compiler writes code in backticks; show it as code.
const pieces = (reason: string) => reason.split('`').map((text, at) => ({ text, code: at % 2 === 1 }))
const plural = (count: number, word: string) => `${count} ${word}${count === 1 ? '' : 'es'}`
---

<figure class="not-content hozo-ui-example">
  <UiStage><slot /></UiStage>
</figure>

{
  native && (
    <div
      class="hozo-ui-native"
      data-native-missing={native.missing.length}
      data-native-unapplied={native.unapplied.length}
    >
      {native.missing.length === 0 && native.unapplied.length === 0 ? (
        <p>
          <strong>React Native:</strong> no class in this look is Web-only
          {native.cosmetic.length > 0 &&
            `, apart from ${plural(native.cosmetic.length, 'class')} for a cursor or a CSS transition`}
          .
        </p>
      ) : (
        <details>
          <summary>
            <strong>React Native:</strong>{' '}
            {[
              native.unapplied.length > 0 &&
                `${native.unapplied.length === 1 ? 'one class prop' : `${native.unapplied.length} class props`} of this look ${native.unapplied.length === 1 ? 'is' : 'are'} not applied there yet`,
              native.missing.length > 0 &&
                `${plural(native.missing.length, 'class')} ${native.missing.length === 1 ? 'has' : 'have'} no effect there`,
              native.cosmetic.length > 0 &&
                `${plural(native.cosmetic.length, 'class')} for a cursor or a CSS transition ${native.cosmetic.length === 1 ? 'does' : 'do'} not apply`,
            ]
              .filter(Boolean)
              .join('; ')}
            .
          </summary>
          {native.unapplied.length > 0 && (
            <p>
              Not applied on React Native yet: the component's Native half accepts{' '}
              {native.unapplied.map((prop, at) => (
                <>
                  {at > 0 && ', '}
                  <code>{prop}</code>
                </>
              ))}{' '}
              and does not use {native.unapplied.length === 1 ? 'it' : 'them'}, so that part of
              the look is missing there whatever its classes are.
            </p>
          )}
          {native.missing.length > 0 && (
            <ul>
              {native.missing.map(({ className, reason }) => (
                <li>
                  <code>{className}</code>:{' '}
                  {pieces(reason).map(({ text, code }) => (code ? <code>{text}</code> : text))}
                </li>
              ))}
            </ul>
          )}
        </details>
      )}
    </div>
  )
}

<Code code={source.trim()} lang="tsx" title={file} />

<style>
  .hozo-ui-example {
    margin-block: 1.5rem 0.5rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.5rem;
    overflow: hidden;
  }
  .hozo-ui-native {
    margin-block: 0 1rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .hozo-ui-native ul {
    margin-block-start: 0.5rem;
  }
</style>
