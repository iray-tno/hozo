{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@hozo/example-next#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@hozo/example-storybook#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/examples/showcase/src/**",
        "$TURBO_ROOT$/examples/showcase/assets/**"
      ],
      "outputs": ["storybook-static/**"]
    },
    "@hozo/example-tanstack-start#build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@hozo/compiler#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/ui/src/combobox.tsx",
        "$TURBO_ROOT$/packages/ui/src/listbox.tsx",
        "$TURBO_ROOT$/packages/ui/src/menu.tsx",
        "$TURBO_ROOT$/packages/engine/src/**",
        "$TURBO_ROOT$/packages/rn-compat/src/**",
        "$TURBO_ROOT$/packages/typography/src/**"
      ]
    },
    "@hozo/tailwind-conformance#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/crates/hozo_ir/src/lib.rs"
      ]
    },
    "@hozo/migration-audit#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/typography/src/**"]
    },
    "@hozo/media#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/examples/showcase/assets/**",
        "$TURBO_ROOT$/packages/patterns/src/slider*.ts",
        "$TURBO_ROOT$/packages/patterns/src/slider*.tsx"
      ]
    },
    "@hozo/example-storybook#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/examples/showcase/src/**",
        "$TURBO_ROOT$/examples/showcase/assets/**",
        "$TURBO_ROOT$/packages/patterns/src/**",
        "$TURBO_ROOT$/packages/ui/src/**",
        "$TURBO_ROOT$/packages/behaviors/src/pressable-interaction.ts",
        "$TURBO_ROOT$/packages/behaviors/src/i18n.ts",
        "$TURBO_ROOT$/packages/behaviors/src/text-child.native.tsx",
        "$TURBO_ROOT$/packages/behaviors/src/presence.native.ts",
        "$TURBO_ROOT$/packages/behaviors/src/portal.native.tsx",
        "$TURBO_ROOT$/packages/behaviors/src/floating-positioner.native.tsx",
        "$TURBO_ROOT$/packages/behaviors/src/floating-positioner.tsx",
        "$TURBO_ROOT$/packages/behaviors/src/dismissable-layer.tsx",
        "$TURBO_ROOT$/packages/behaviors/src/floating-geometry.ts",
        "$TURBO_ROOT$/packages/engine/src/navigation*.ts",
        "$TURBO_ROOT$/packages/engine/src/navigation*.tsx",
        "$TURBO_ROOT$/packages/engine/src/transform-slots.ts"
      ]
    },
    "@hozo/example-native-showcase#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/examples/showcase/src/**",
        "$TURBO_ROOT$/examples/showcase/assets/**",
        "$TURBO_ROOT$/examples/storybook-demo/src/**",
        "$TURBO_ROOT$/packages/compiler/src/**",
        "$TURBO_ROOT$/packages/metro/src/**",
        "$TURBO_ROOT$/packages/patterns/src/**",
        "$TURBO_ROOT$/packages/svg/src/**",
        "$TURBO_ROOT$/packages/three/src/**"
      ]
    },
    "test:performance": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "report": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
