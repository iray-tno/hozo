{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@hozo/example-next#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@hozo/example-storybook#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/examples/showcase/src/**",
        "$TURBO_ROOT$/examples/showcase/assets/**"
      ],
      "outputs": ["storybook-static/**"]
    },
    "@hozo/example-tanstack-start#build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@hozo/compiler#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/ui/src/combobox.tsx",
        "$TURBO_ROOT$/packages/ui/src/listbox.tsx",
        "$TURBO_ROOT$/packages/ui/src/menu.tsx",
        "$TURBO_ROOT$/packages/engine/src/**",
        "$TURBO_ROOT$/packages/rn-compat/src/**",
        "$TURBO_ROOT$/packages/typography/src/**"
      ]
    },
    "@hozo/tailwind#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/crates/hozo_parser/src/tailwind_variants.rs"]
    },
    "@hozo/tailwind-conformance#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/crates/hozo_native/src/text.rs",
        "$TURBO_ROOT$/crates/hozo_ir/src/lib.rs"
      ]
    },
    "@hozo/migration-audit#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/typography/src/**"]
    },
    "@hozo/metro#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/ui/src/**"]
    },
    "@hozo/media#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/examples/showcase/assets/**",
        "$TURBO_ROOT$/packages/patterns/src/slider*.ts",
        "$TURBO_ROOT$/packages/patterns/src/slider*.tsx",
        "$TURBO_ROOT$/packages/behaviors/src/pressable-interaction.ts",
        "$TURBO_ROOT$/examples/native-showcase/src/Audio.stories.tsx",
        "$TURBO_ROOT$/examples/native-showcase/src/Video.stories.tsx",
        "$TURBO_ROOT$/examples/native-showcase/tsconfig.json",
        "$TURBO_ROOT$/examples/storybook-demo/src/Audio.stories.tsx",
        "$TURBO_ROOT$/examples/storybook-demo/src/Video.stories.tsx",
        "$TURBO_ROOT$/examples/storybook-demo/tsconfig.json"
      ]
    },
    "@hozo/example-storybook#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/examples/showcase/src/**",
        "$TURBO_ROOT$/examples/showcase/assets/**",
        "$TURBO_ROOT$/packages/patterns/src/**",
        "$TURBO_ROOT$/packages/form/src/**",
        "$TURBO_ROOT$/packages/ui/src/**",
        "$TURBO_ROOT$/packages/behaviors/src/pressable-interaction.ts",
        "$TURBO_ROOT$/packages/behaviors/src/i18n.ts",
        "$TURBO_ROOT$/packages/behaviors/src/live-region.native.tsx",
        "$TURBO_ROOT$/packages/behaviors/src/live-region.tsx",
        "$TURBO_ROOT$/packages/behaviors/src/text-child.native.tsx",
        "$TURBO_ROOT$/packages/behaviors/src/presence.native.ts",
        "$TURBO_ROOT$/packages/behaviors/src/focus-scope.native.tsx",
        "$TURBO_ROOT$/packages/behaviors/src/focus-scope.tsx",
        "$TURBO_ROOT$/packages/behaviors/src/accessibility-focus.native.ts",
        "$TURBO_ROOT$/packages/behaviors/src/hover-trigger.native.tsx",
        "$TURBO_ROOT$/packages/behaviors/src/hover-geometry.ts",
        "$TURBO_ROOT$/packages/behaviors/src/portal.native.tsx",
        "$TURBO_ROOT$/packages/behaviors/src/portal.tsx",
        "$TURBO_ROOT$/packages/behaviors/src/floating-positioner.native.tsx",
        "$TURBO_ROOT$/packages/behaviors/src/floating-positioner.tsx",
        "$TURBO_ROOT$/packages/behaviors/src/dismissable-layer.tsx",
        "$TURBO_ROOT$/packages/behaviors/src/floating-geometry.ts",
        "$TURBO_ROOT$/packages/engine/src/navigation*.ts",
        "$TURBO_ROOT$/packages/engine/src/navigation*.tsx",
        "$TURBO_ROOT$/packages/engine/src/transform-slots.ts",
        "$TURBO_ROOT$/packages/engine/src/spread-styles.ts",
        "$TURBO_ROOT$/packages/metro/src/**"
      ]
    },
    "@hozo/example-native-showcase#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/workflows/deploy-pages.yml",
        "$TURBO_ROOT$/.github/workflows/native-showcase.yml",
        "$TURBO_ROOT$/examples/showcase/src/**",
        "$TURBO_ROOT$/examples/showcase/assets/**",
        "$TURBO_ROOT$/examples/storybook-demo/src/**",
        "$TURBO_ROOT$/packages/compiler/src/**",
        "$TURBO_ROOT$/packages/metro/src/**",
        "$TURBO_ROOT$/packages/tailwind-conformance/package.json",
        "$TURBO_ROOT$/packages/tailwind-conformance/fixtures/native-text-label.tsx",
        "$TURBO_ROOT$/packages/tailwind-conformance/fixtures/native-text-opaque-label.tsx",
        "$TURBO_ROOT$/packages/tailwind-conformance/src/text-inheritance-reference-core.ts",
        "$TURBO_ROOT$/packages/tailwind-conformance/src/text-inheritance-device-source.ts",
        "$TURBO_ROOT$/crates/hozo_napi/src/lib.rs",
        "$TURBO_ROOT$/crates/hozo_parser/src/lib.rs",
        "$TURBO_ROOT$/crates/hozo_parser/src/interaction_order.rs",
        "$TURBO_ROOT$/crates/hozo_parser/src/jsx.rs",
        "$TURBO_ROOT$/crates/hozo_parser/src/tailwind_variants.rs",
        "$TURBO_ROOT$/crates/hozo_parser/src/text_regions.rs",
        "$TURBO_ROOT$/crates/hozo_native/src/lib.rs",
        "$TURBO_ROOT$/crates/hozo_native/src/text_region.rs",
        "$TURBO_ROOT$/crates/hozo_native/src/style.rs",
        "$TURBO_ROOT$/crates/hozo_native/src/render.rs",
        "$TURBO_ROOT$/crates/hozo_native/src/text.rs",
        "$TURBO_ROOT$/crates/hozo_ir/src/lib.rs",
        "$TURBO_ROOT$/packages/tailwind-conformance/src/text-inheritance-closed-proof.ts",
        "$TURBO_ROOT$/packages/tailwind-conformance/src/text-inheritance-proof-boundary.ts",
        "$TURBO_ROOT$/packages/tailwind-conformance/src/text-inheritance-style-proof.ts",
        "$TURBO_ROOT$/packages/tailwind-conformance/src/text-inheritance-fixtures.ts",
        "$TURBO_ROOT$/packages/core/src/generated/inherited-text.ts",
        "$TURBO_ROOT$/packages/core/src/generated/inherited-relative-text.ts",
        "$TURBO_ROOT$/packages/core/src/generated/inherited-view.ts",
        "$TURBO_ROOT$/packages/engine/src/generated/text-inheritance-protocol.ts",
        "$TURBO_ROOT$/packages/engine/src/generated/text-size-context.ts",
        "$TURBO_ROOT$/packages/engine/src/text-inheritance.ts",
        "$TURBO_ROOT$/packages/engine/src/text-size.ts",
        "$TURBO_ROOT$/packages/primitives/src/generated/inherited-text.ts",
        "$TURBO_ROOT$/packages/primitives/src/generated/inherited-relative-text.ts",
        "$TURBO_ROOT$/packages/primitives/src/generated/inherited-view.ts",
        "$TURBO_ROOT$/packages/primitives/src/inherited-text.native.tsx",
        "$TURBO_ROOT$/packages/primitives/src/inherited-relative-text.native.tsx",
        "$TURBO_ROOT$/packages/primitives/src/inherited-view.native.tsx",
        "$TURBO_ROOT$/packages/primitives/src/inherited-text-scope.tsx",
        "$TURBO_ROOT$/packages/primitives/src/inherited-text-style.native.ts",
        "$TURBO_ROOT$/packages/ui/src/theme.css",
        "$TURBO_ROOT$/packages/patterns/src/**",
        "$TURBO_ROOT$/packages/svg/src/**",
        "$TURBO_ROOT$/packages/three/src/**"
      ]
    },
    "test:performance": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "report": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
