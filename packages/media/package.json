{
  "name": "@hozo/media",
  "version": "0.3.1",
  "description": "Universal video and audio playback with shared controls and platform-owned engines.",
  "keywords": [
    "react-native",
    "react",
    "video",
    "audio",
    "media",
    "expo"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iray-tno/hozo.git",
    "directory": "packages/media"
  },
  "homepage": "https://iray-tno.github.io/hozo/",
  "bugs": {
    "url": "https://github.com/iray-tno/hozo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.native.d.ts",
        "default": "./dist/index.native.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./audio": {
      "react-native": {
        "types": "./dist/audio-index.native.d.ts",
        "default": "./dist/audio-index.native.js"
      },
      "types": "./dist/audio-index.d.ts",
      "default": "./dist/audio-index.js"
    },
    "./captions": {
      "react-native": {
        "types": "./dist/captions-index.native.d.ts",
        "default": "./dist/captions-index.native.js"
      },
      "types": "./dist/captions-index.d.ts",
      "default": "./dist/captions-index.js"
    },
    "./seek": {
      "react-native": {
        "types": "./dist/seek-index.native.d.ts",
        "default": "./dist/seek-index.native.js"
      },
      "types": "./dist/seek-index.d.ts",
      "default": "./dist/seek-index.js"
    },
    "./source": {
      "react-native": {
        "types": "./dist/source-index.native.d.ts",
        "default": "./dist/source-index.native.js"
      },
      "types": "./dist/source-index.d.ts",
      "default": "./dist/source-index.js"
    },
    "./source/expo": {
      "react-native": {
        "types": "./dist/expo-source-index.native.d.ts",
        "default": "./dist/expo-source-index.native.js"
      },
      "types": "./dist/expo-source-index.d.ts",
      "default": "./dist/expo-source-index.js"
    },
    "./webvtt": {
      "react-native": {
        "types": "./dist/webvtt-index.native.d.ts",
        "default": "./dist/webvtt-index.native.js"
      },
      "types": "./dist/webvtt-index.d.ts",
      "default": "./dist/webvtt-index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.bench.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 .test-build/*.test.js tests/*.test.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.86",
    "expo-video": ">=57.0.5 <58",
    "expo-audio": ">=57.0.5 <58",
    "expo-asset": ">=57.0.18 <58"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "expo-video": {
      "optional": true
    },
    "expo-audio": {
      "optional": true
    },
    "expo-asset": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "esbuild": "0.28.2",
    "expo-video": "~57.0.5",
    "expo-audio": "~57.0.5",
    "expo-asset": "~57.0.18",
    "playwright-core": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "^0.87.1",
    "react-test-renderer": "^19.2.8"
  }
}
