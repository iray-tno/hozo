{
  "name": "@hozo/runtime",
  "version": "0.1.0",
  "description": "Runtime fallback for genuinely dynamic styles, interactive behavior, and accessibility behavior.",
  "keywords": [
    "react-native",
    "runtime",
    "styles",
    "animation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iray-tno/hozo.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/iray-tno/hozo/tree/main/packages/runtime#readme",
  "bugs": {
    "url": "https://github.com/iray-tno/hozo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.native.d.ts",
        "default": "./dist/index.native.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./navigation": {
      "react-native": {
        "types": "./dist/navigation-entry.native.d.ts",
        "default": "./dist/navigation-entry.native.js"
      },
      "types": "./dist/navigation-entry.d.ts",
      "default": "./dist/navigation-entry.js"
    },
    "./project": {
      "react-native": {
        "types": "./dist/project.native.d.ts",
        "default": "./dist/project.native.js"
      },
      "types": "./dist/project.d.ts",
      "default": "./dist/project.js"
    },
    "./svg": {
      "react-native": {
        "types": "./dist/svg.native.d.ts",
        "default": "./dist/svg.native.js"
      },
      "types": "./dist/svg.d.ts",
      "default": "./dist/svg.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.bench.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test src/*.test.ts",
    "test:performance": "node --test src/*.bench.ts",
    "test:browser": "node scripts/check-list.mjs"
  },
  "dependencies": {
    "@hozo/behaviors": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.76",
    "react-native-safe-area-context": ">=4",
    "react-native-svg": ">=15"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "^0.87.0",
    "react-native-svg": "^15.15.5"
  }
}
