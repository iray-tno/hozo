{
  "schema": "rfc010-spike-0",
  "owner": "BottomSheet.handle",
  "classProp": "handleClassName",
  "audit": "unknown",
  "abi": {
    "nativePreparedProp": "hozoHandleStyle",
    "nativeAuthorProp": "handleStyle",
    "webClassProp": "handleClassName"
  },
  "shapes": [
    {
      "id": "resizable",
      "when": { "open": true, "resizable": true },
      "nativeHost": "Pressable",
      "webHost": "button",
      "events": ["pressed", "hovered", "focused", "focusVisible"]
    },
    {
      "id": "decorative",
      "when": { "open": true, "resizable": false },
      "nativeHost": "View",
      "webHost": "div",
      "events": []
    }
  ]
}
