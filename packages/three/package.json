{
  "name": "@hozo/three",
  "version": "0.1.0",
  "description": "Projects Three.js scenes into portable Hozo Canvas scenes.",
  "keywords": [
    "react-native",
    "three.js",
    "3d",
    "canvas",
    "graphics"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iray-tno/hozo.git",
    "directory": "packages/three"
  },
  "homepage": "https://iray-tno.github.io/hozo/",
  "bugs": {
    "url": "https://github.com/iray-tno/hozo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./conformance-scenes": {
      "types": "./dist/conformance-scenes.d.ts",
      "default": "./dist/conformance-scenes.js"
    },
    "./r3f": {
      "react-native": {
        "types": "./dist/r3f-react-native.d.ts",
        "default": "./dist/r3f-react-native.js"
      },
      "types": "./dist/r3f.d.ts",
      "default": "./dist/r3f.js"
    },
    "./r3f-native": {
      "react-native": {
        "types": "./dist/r3f-native.d.ts",
        "default": "./dist/r3f-native.js"
      },
      "types": "./dist/r3f-native-unavailable.d.ts",
      "default": "./dist/r3f-native-unavailable.js"
    },
    "./scene-conformance.json": "./scene-conformance.json",
    "./webgl": {
      "react-native": {
        "types": "./dist/webgl-react-native.d.ts",
        "default": "./dist/webgl-react-native.js"
      },
      "types": "./dist/webgl-renderer.d.ts",
      "default": "./dist/webgl-renderer.js"
    },
    "./webgpu": {
      "react-native": {
        "types": "./dist/webgpu-react-native.d.ts",
        "default": "./dist/webgpu-react-native.js"
      },
      "types": "./dist/webgpu.d.ts",
      "default": "./dist/webgpu.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "conformance.md",
    "dist",
    "scene-conformance.json",
    "scene-conformance.md",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.bench.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p .",
    "report": "node scripts/report-conformance.ts && node scripts/report-scenes.ts",
    "test:gpu": "node scripts/check-gpu.mjs",
    "typecheck": "tsc -p . --noEmit",
    "test": "node -e \"require('node:fs').rmSync('.test-build', { recursive: true, force: true })\" && tsc -p tsconfig.test.json && node --test .test-build/*.test.js && node --test scripts/conformance.test.ts scripts/renderer-entrypoints.test.ts scripts/scene-corpus.test.ts && node scripts/report-conformance.ts --check && node scripts/report-scenes.ts --check"
  },
  "dependencies": {
    "@hozo/canvas": "workspace:^",
    "@hozo/engine": "workspace:^"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=9",
    "react": "^19.0.0",
    "react-native": ">=0.86",
    "three": ">=0.170"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-three/fiber": "^9.8.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.180.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "^0.87.1",
    "react-test-renderer": "^19.2.8",
    "three": "^0.180.0"
  }
}
