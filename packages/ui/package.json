{
  "name": "@hozo/ui",
  "version": "0.1.0",
  "description": "A styled component library for Hozo, shipped as source and compiled by your own build.",
  "keywords": [
    "react-native",
    "react",
    "design-system",
    "tailwind",
    "accessibility"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iray-tno/hozo.git",
    "directory": "packages/ui"
  },
  "homepage": "https://iray-tno.github.io/hozo/",
  "bugs": {
    "url": "https://github.com/iray-tno/hozo/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "test": "node -e \"require('node:fs').rmSync('.test-build', { recursive: true, force: true })\" && tsc -p tsconfig.test.json && node --test .test-build/*.test.js"
  },
  "dependencies": {
    "@hozo/patterns": "workspace:^",
    "@hozo/primitives": "workspace:^",
    "@hozo/typography": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.86"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "^0.87.1"
  }
}
