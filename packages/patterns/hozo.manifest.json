                    "resizable",
                    true
                  ]
                }
              ]
            },
            "nativeHost": "Pressable",
            "webHost": "button",
            "events": [
              "pressed",
              "hovered",
              "focused",
              "focusVisible"
            ],
            "inputs": {
              "facts": [],
              "splitText": false
            }
          },
