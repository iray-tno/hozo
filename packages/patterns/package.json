{
  "name": "@hozo/patterns",
  "version": "0.2.0",
  "description": "Accessible composite UI patterns for Hozo applications.",
  "keywords": [
    "react-native",
    "react",
    "patterns",
    "accessibility",
    "components"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iray-tno/hozo.git",
    "directory": "packages/patterns"
  },
  "homepage": "https://iray-tno.github.io/hozo/",
  "bugs": {
    "url": "https://github.com/iray-tno/hozo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.native.d.ts",
        "default": "./dist/index.native.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generated/avatar": {
      "react-native": {
        "types": "./dist/generated/avatar.native.d.ts",
        "default": "./dist/generated/avatar.native.js"
      },
      "types": "./dist/generated/avatar.d.ts",
      "default": "./dist/generated/avatar.js"
    },
    "./generated/chip": {
      "react-native": {
        "types": "./dist/generated/chip.native.d.ts",
        "default": "./dist/generated/chip.native.js"
      },
      "types": "./dist/generated/chip.d.ts",
      "default": "./dist/generated/chip.js"
    },
    "./generated/dialog": {
      "react-native": {
        "types": "./dist/generated/dialog.native.d.ts",
        "default": "./dist/generated/dialog.native.js"
      },
      "types": "./dist/generated/dialog.d.ts",
      "default": "./dist/generated/dialog.js"
    },
    "./generated/pagination": {
      "react-native": {
        "types": "./dist/generated/pagination.native.d.ts",
        "default": "./dist/generated/pagination.native.js"
      },
      "types": "./dist/generated/pagination.d.ts",
      "default": "./dist/generated/pagination.js"
    },
    "./generated/stepper": {
      "react-native": {
        "types": "./dist/generated/stepper.native.d.ts",
        "default": "./dist/generated/stepper.native.js"
      },
      "types": "./dist/generated/stepper.d.ts",
      "default": "./dist/generated/stepper.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.bench.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node -e \"require('node:fs').rmSync('.test-build', { recursive: true, force: true })\" && tsc -p tsconfig.test.json && node --test .test-build/*.test.js"
  },
  "dependencies": {
    "@hozo/behaviors": "workspace:^",
    "@hozo/engine": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.86"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "^0.87.1"
  }
}
