{
  "name": "@hozo/patterns",
  "version": "0.1.0",
  "description": "Accessible composite UI patterns for Hozo applications.",
  "keywords": [
    "react-native",
    "react",
    "patterns",
    "accessibility",
    "components"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iray-tno/hozo.git",
    "directory": "packages/patterns"
  },
  "homepage": "https://github.com/iray-tno/hozo/tree/main/packages/patterns#readme",
  "bugs": {
    "url": "https://github.com/iray-tno/hozo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.native.d.ts",
        "default": "./dist/index.native.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.bench.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node -e \"require('node:fs').rmSync('.test-build', { recursive: true, force: true })\" && tsc -p tsconfig.test.json && node --test .test-build/*.test.js"
  },
  "dependencies": {
    "@hozo/behaviors": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.76"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "^0.87.0"
  }
}
