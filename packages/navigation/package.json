{
  "name": "@hozo/navigation",
  "version": "0.2.0",
  "description": "Router-agnostic universal navigation for Hozo links and destination-bearing controls.",
  "keywords": [
    "react-native",
    "react",
    "navigation",
    "router",
    "deep-linking",
    "universal"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iray-tno/hozo.git",
    "directory": "packages/navigation"
  },
  "homepage": "https://github.com/iray-tno/hozo/tree/main/packages/navigation#readme",
  "bugs": {
    "url": "https://github.com/iray-tno/hozo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "hozo-links": "./dist/verification-cli.js"
  },
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.native.d.ts",
        "default": "./dist/index.native.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./typed": {
      "types": "./dist/typed.d.ts",
      "default": "./dist/typed.js"
    },
    "./next": {
      "react-native": {
        "types": "./dist/next.native.d.ts",
        "default": "./dist/next.native.js"
      },
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./expo-router": {
      "react-native": {
        "types": "./dist/expo-router.native.d.ts",
        "default": "./dist/expo-router.native.js"
      },
      "types": "./dist/expo-router.d.ts",
      "default": "./dist/expo-router.js"
    },
    "./expo-router/typed": {
      "types": "./dist/expo-typed.d.ts",
      "default": "./dist/expo-typed.js"
    },
    "./expo-config": {
      "types": "./dist/expo-config.d.ts",
      "default": "./dist/expo-config.js"
    },
    "./tanstack-router": {
      "react-native": {
        "types": "./dist/tanstack-router.native.d.ts",
        "default": "./dist/tanstack-router.native.js"
      },
      "types": "./dist/tanstack-router.d.ts",
      "default": "./dist/tanstack-router.js"
    },
    "./tanstack-router/typed": {
      "types": "./dist/tanstack-typed.d.ts",
      "default": "./dist/tanstack-typed.js"
    },
    "./verification": {
      "types": "./dist/verification.d.ts",
      "default": "./dist/verification.js"
    },
    "./verification/node": {
      "types": "./dist/verification-node.d.ts",
      "default": "./dist/verification-node.js"
    },
    "./hozo-links.schema.json": "./hozo-links.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "hozo-links.schema.json",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.bench.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node -e \"require('node:fs').rmSync('.test-build', { recursive: true, force: true })\" && tsc -p tsconfig.test.json && node --test .test-build/*.test.js"
  },
  "dependencies": {
    "@hozo/runtime": "workspace:^"
  },
  "peerDependencies": {
    "@hozo/core": ">=0.2.0",
    "@tanstack/react-router": ">=1.100",
    "react": "^19.0.0",
    "react-native": ">=0.76"
  },
  "peerDependenciesMeta": {
    "@hozo/core": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hozo/core": "workspace:^",
    "@tanstack/react-router": "^1.170.29",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "react-native": "^0.87.0"
  }
}
