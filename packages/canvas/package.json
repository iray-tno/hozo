{
  "name": "@hozo/canvas",
  "version": "0.1.0",
  "description": "A declarative Canvas scene for Hozo, rendered by Canvas 2D on Web and Skia on React Native.",
  "keywords": [
    "react-native",
    "canvas",
    "graphics",
    "skia",
    "charts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iray-tno/hozo.git",
    "directory": "packages/canvas"
  },
  "homepage": "https://github.com/iray-tno/hozo/tree/main/packages/canvas#readme",
  "bugs": {
    "url": "https://github.com/iray-tno/hozo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.native.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/*.test.js"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.76"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "^0.87.0",
    "react-test-renderer": "^19.2.8"
  }
}
