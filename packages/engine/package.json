{
  "name": "@hozo/engine",
  "version": "0.2.0",
  "description": "Runtime fallback for genuinely dynamic styles, interactive behavior, and accessibility behavior.",
  "keywords": [
    "react-native",
    "runtime",
    "styles",
    "animation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iray-tno/hozo.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/iray-tno/hozo/tree/main/packages/engine#readme",
  "bugs": {
    "url": "https://github.com/iray-tno/hozo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/hooks.native.js"
  ],
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.native.d.ts",
        "default": "./dist/index.native.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./navigation": {
      "react-native": {
        "types": "./dist/navigation-entry.native.d.ts",
        "default": "./dist/navigation-entry.native.js"
      },
      "types": "./dist/navigation-entry.d.ts",
      "default": "./dist/navigation-entry.js"
    },
    "./project": {
      "react-native": {
        "types": "./dist/project.native.d.ts",
        "default": "./dist/project.native.js"
      },
      "types": "./dist/project.d.ts",
      "default": "./dist/project.js"
    },
    "./generated/animation": {
      "types": "./dist/generated/animation.d.ts",
      "default": "./dist/generated/animation.js"
    },
    "./generated/class-resolver": {
      "types": "./dist/generated/class-resolver.d.ts",
      "default": "./dist/generated/class-resolver.js"
    },
    "./generated/dom-style": {
      "react-native": {
        "types": "./dist/generated/dom-style.native.d.ts",
        "default": "./dist/generated/dom-style.native.js"
      },
      "types": "./dist/generated/dom-style.d.ts",
      "default": "./dist/generated/dom-style.js"
    },
    "./generated/environment": {
      "types": "./dist/generated/environment.d.ts",
      "default": "./dist/generated/environment.js"
    },
    "./generated/image-source": {
      "types": "./dist/generated/image-source.d.ts",
      "default": "./dist/generated/image-source.js"
    },
    "./generated/interactive": {
      "types": "./dist/generated/interactive.d.ts",
      "default": "./dist/generated/interactive.js"
    },
    "./generated/safe-area": {
      "types": "./dist/generated/safe-area.d.ts",
      "default": "./dist/generated/safe-area.js"
    },
    "./generated/scrollable": {
      "types": "./dist/generated/scrollable.d.ts",
      "default": "./dist/generated/scrollable.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.bench.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test src/*.test.ts",
    "test:performance": "node --test src/*.bench.ts"
  },
  "dependencies": {},
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.76",
    "react-native-safe-area-context": ">=4"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "^0.87.0",
    "react-test-renderer": "^19.2.8"
  }
}
