{
  "name": "@hozo/rn-compat",
  "version": "0.1.0",
  "description": "Optional React Native compatibility APIs for incrementally migrating applications to Hozo.",
  "keywords": [
    "react-native",
    "compatibility",
    "migration",
    "react-native-web"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iray-tno/hozo.git",
    "directory": "packages/rn-compat"
  },
  "homepage": "https://github.com/iray-tno/hozo/tree/main/packages/rn-compat#readme",
  "bugs": {
    "url": "https://github.com/iray-tno/hozo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.native.d.ts",
        "default": "./dist/index.native.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generated/activity-indicator": {
      "react-native": {
        "types": "./dist/generated/activity-indicator.native.d.ts",
        "default": "./dist/generated/activity-indicator.native.js"
      },
      "types": "./dist/generated/activity-indicator.d.ts",
      "default": "./dist/generated/activity-indicator.js"
    },
    "./generated/animated-view": {
      "react-native": {
        "types": "./dist/generated/animated-view.native.d.ts",
        "default": "./dist/generated/animated-view.native.js"
      },
      "types": "./dist/generated/animated-view.d.ts",
      "default": "./dist/generated/animated-view.js"
    },
    "./generated/modal": {
      "react-native": {
        "types": "./dist/generated/modal.native.d.ts",
        "default": "./dist/generated/modal.native.js"
      },
      "types": "./dist/generated/modal.d.ts",
      "default": "./dist/generated/modal.js"
    },
    "./generated/touchable-opacity": {
      "react-native": {
        "types": "./dist/generated/touchable-opacity.native.d.ts",
        "default": "./dist/generated/touchable-opacity.native.js"
      },
      "types": "./dist/generated/touchable-opacity.d.ts",
      "default": "./dist/generated/touchable-opacity.js"
    },
    "./generated/touchable-without-feedback": {
      "react-native": {
        "types": "./dist/generated/touchable-without-feedback.native.d.ts",
        "default": "./dist/generated/touchable-without-feedback.native.js"
      },
      "types": "./dist/generated/touchable-without-feedback.d.ts",
      "default": "./dist/generated/touchable-without-feedback.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.bench.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test src/*.test.ts"
  },
  "dependencies": {
    "@hozo/primitives": "workspace:^",
    "@hozo/engine": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.86"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "^0.87.1",
    "react-test-renderer": "^19.2.8"
  }
}
