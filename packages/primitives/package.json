{
  "name": "@hozo/primitives",
  "version": "0.2.0",
  "description": "Canonical universal UI primitives for Hozo applications.",
  "keywords": [
    "react-native",
    "react",
    "primitives",
    "components",
    "universal"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iray-tno/hozo.git",
    "directory": "packages/primitives"
  },
  "homepage": "https://github.com/iray-tno/hozo/tree/main/packages/primitives#readme",
  "bugs": {
    "url": "https://github.com/iray-tno/hozo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.native.d.ts",
        "default": "./dist/index.native.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generated/animated": {
      "types": "./dist/generated/animated.d.ts",
      "default": "./dist/generated/animated.js"
    },
    "./generated/backdrop-filter": {
      "types": "./dist/generated/backdrop-filter.d.ts",
      "default": "./dist/generated/backdrop-filter.js"
    },
    "./generated/container": {
      "types": "./dist/generated/container.d.ts",
      "default": "./dist/generated/container.js"
    },
    "./generated/flat-list": {
      "react-native": {
        "types": "./dist/generated/flat-list.native.d.ts",
        "default": "./dist/generated/flat-list.native.js"
      },
      "types": "./dist/generated/flat-list.d.ts",
      "default": "./dist/generated/flat-list.js"
    },
    "./generated/grid": {
      "types": "./dist/generated/grid.d.ts",
      "default": "./dist/generated/grid.js"
    },
    "./generated/link": {
      "react-native": {
        "types": "./dist/generated/link.native.d.ts",
        "default": "./dist/generated/link.native.js"
      },
      "types": "./dist/generated/link.d.ts",
      "default": "./dist/generated/link.js"
    },
    "./generated/pressable": {
      "react-native": {
        "types": "./dist/generated/pressable.native.d.ts",
        "default": "./dist/generated/pressable.native.js"
      },
      "types": "./dist/generated/pressable.d.ts",
      "default": "./dist/generated/pressable.js"
    },
    "./generated/refresh-control": {
      "react-native": {
        "types": "./dist/generated/refresh-control.native.d.ts",
        "default": "./dist/generated/refresh-control.native.js"
      },
      "types": "./dist/generated/refresh-control.d.ts",
      "default": "./dist/generated/refresh-control.js"
    },
    "./generated/scroll-view": {
      "react-native": {
        "types": "./dist/generated/scroll-view.native.d.ts",
        "default": "./dist/generated/scroll-view.native.js"
      },
      "types": "./dist/generated/scroll-view.d.ts",
      "default": "./dist/generated/scroll-view.js"
    },
    "./generated/spaced": {
      "types": "./dist/generated/spaced.d.ts",
      "default": "./dist/generated/spaced.js"
    },
    "./generated/text": {
      "types": "./dist/generated/text.d.ts",
      "default": "./dist/generated/text.js"
    },
    "./generated/text-input": {
      "react-native": {
        "types": "./dist/generated/text-input.native.d.ts",
        "default": "./dist/generated/text-input.native.js"
      },
      "types": "./dist/generated/text-input.d.ts",
      "default": "./dist/generated/text-input.js"
    },
    "./generated/text-size": {
      "types": "./dist/generated/text-size.d.ts",
      "default": "./dist/generated/text-size.js"
    },
    "./generated/view": {
      "react-native": {
        "types": "./dist/generated/view.native.d.ts",
        "default": "./dist/generated/view.native.js"
      },
      "types": "./dist/generated/view.d.ts",
      "default": "./dist/generated/view.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.bench.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node -e \"require('node:fs').rmSync('.test-build', { recursive: true, force: true })\" && tsc -p tsconfig.test.json && node --test .test-build/*.test.js",
    "test:browser": "node scripts/check-list.mjs"
  },
  "dependencies": {
    "@hozo/behaviors": "workspace:^",
    "@hozo/engine": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.76"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "^0.87.0"
  }
}
