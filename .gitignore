temp/

# JS / pnpm
node_modules/
dist/
dist-ssr/
.output/
storybook-static/
artifacts/
.next/
# The bundler comparison builds into one of these per bundler, so that it
# never shares a directory with the `build` script running beside it.
.next-check-*/
next-env.d.ts
# Next 16 writes these into the app on dev startup.
examples/*/AGENTS.md
examples/*/CLAUDE.md
.turbo/
.astro/
*.log

# Hozo build artifacts
*.hozo.css
*.node

# Rust
target/

# Editor / OS
.DS_Store
.vscode/
.idea/
.typecheck-*/
.render-*/
.native-render-*/
.tsx-*/
.theme-test-*/
.probe-*/
.test-build/
junit-reports/
allure-history/

# Per-user tool settings. Ignored here rather than only in a contributor's
# global excludes: Biome reads this file and not that one, so a machine
# with one of these would fail `pnpm lint` while CI, which has none, passed.
.claude/settings.local.json

# Built by `node scripts/build-wasm.mjs`, which needs the
# `wasm32-unknown-unknown` target and a version-matched `wasm-bindgen` --
# more than `pnpm install` provides, and 1.3MB that would be committed
# again on every compiler change.
packages/compiler/wasm/

# Copied from packages/compiler/wasm by scripts/copy-wasm.mjs.
apps/landing/public/wasm/

# Android. The project under examples/native-demo is checked in -- it is what
# CI boots -- but everything Gradle and the SDK write into it is not.
# `local.properties` in particular holds an absolute SDK path and belongs to
# one machine.
.gradle/
build/
local.properties
*.keystore
!examples/native-demo/android/app/debug.keystore
*.apk
.cxx/

# iOS. Same rule as Android above: the project under examples/native-demo is
# checked in, and everything Xcode and CocoaPods write into it is not. The
# list is React Native's own template gitignore, trimmed to what this
# repository can actually produce.
**/Pods/
xcuserdata/
DerivedData/
*.xcworkspace
*.xcuserstate
*.hmap
*.ipa
**/.xcode.env.local
# Not committed, because it can only be generated on macOS and nothing in
# this repository is developed there. CI runs `pod install` and the build's
# own manifest check compares the two files it just wrote, so they agree
# within a run; what floats between runs is the pod versions, which React
# Native pins to its own release for all but a few mirrors.
Podfile.lock
