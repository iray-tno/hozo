{
  "schema": "rfc010-owner-shadow-0",
  "contracts": [
    {
      "owner": "BottomSheet.handle",
      "classProp": "handleClassName",
      "audit": "unknown",
      "bindings": [
        "open",
        "resizable"
      ],
      "abi": {
        "nativePreparedProp": "hozoHandleStyle",
        "webClassProp": "handleClassName"
      },
      "authoredStyles": [
        {
          "prop": "handleStyle",
          "order": 0
        }
      ],
      "shapes": [
        {
          "id": "resizable",
          "when": {
            "all": [
              {
                "eq": [
                  "open",
                  true
                ]
              },
              {
                "eq": [
                  "resizable",
                  true
                ]
              }
            ]
          },
          "nativeHost": "Pressable",
          "webHost": "button",
          "events": [
            "pressed",
            "hovered",
            "focused",
            "focusVisible"
          ]
        },
        {
          "id": "decorative",
          "when": {
            "all": [
              {
                "eq": [
                  "open",
                  true
                ]
              },
              {
                "eq": [
                  "resizable",
                  false
                ]
              }
            ]
          },
          "nativeHost": "View",
          "webHost": "div",
          "events": []
        }
      ]
    }
  ]
}
