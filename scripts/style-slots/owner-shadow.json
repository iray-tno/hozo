{
  "schema": "rfc010-owner-shadow-0",
  "contracts": [
    {
      "owner": "BottomSheet.handle",
      "classProp": "handleClassName",
      "audit": "unknown",
      "bindings": [
        "present",
        "resizable"
      ],
      "abi": {
        "nativePreparedProp": "hozoHandleStyle",
        "webClassProp": "handleClassName"
      },
      "authoredStyles": [
        {
          "prop": "handleStyle",
          "order": 0
        }
      ],
      "shapes": [
        {
          "id": "resizable",
          "when": {
            "all": [
              {
                "eq": [
                  "present",
                  true
                ]
              },
              {
                "eq": [
                  "resizable",
                  true
                ]
              }
            ]
          },
          "nativeHost": "Pressable",
          "webHost": "button",
          "events": [
            "pressed",
            "hovered",
            "focused",
            "focusVisible"
          ]
        },
        {
          "id": "decorative",
          "when": {
            "all": [
              {
                "eq": [
                  "present",
                  true
                ]
              },
              {
                "eq": [
                  "resizable",
                  false
                ]
              }
            ]
          },
          "nativeHost": "View",
          "webHost": "div",
          "events": []
        }
      ]
    },
    {
      "owner": "Tabs.Tab",
      "classProp": "tabClassName",
      "audit": "unknown",
      "bindings": [
        "present"
      ],
      "abi": {
        "nativePreparedProp": "hozoTabStyle",
        "webClassProp": "tabClassName"
      },
      "authoredStyles": [
        {
          "prop": "tabStyle",
          "order": 0
        }
      ],
      "shapes": [
        {
          "id": "tab",
          "when": {
            "eq": [
              "present",
              true
            ]
          },
          "nativeHost": "Pressable",
          "webHost": "button",
          "events": [
            "pressed",
            "hovered",
            "focused",
            "focusVisible"
          ],
          "inputs": {
            "facts": [
              "disabled",
              "aria-selected",
              "aria-disabled"
            ],
            "splitText": true
          }
        }
      ]
    }
  ]
}
